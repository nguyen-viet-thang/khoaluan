@model PopPop.Models.EditStaffAccountViewModel
@using PopPop.Areas.Admin.Controllers
@{
    ViewData["Title"] = $"Nhân viên {Model.FullName}";
}
<div class="admin-page-heading">
    <div><h2>@Model.FullName</h2><p>@(string.IsNullOrEmpty(Model.Email) ? "Chưa có Gmail" : Model.Email) · @Model.PhoneNumber · tạo ngày @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</p></div>
    <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="StaffAccounts" asp-action="Index"><i class="fa fa-arrow-left"></i>Danh sách nhân viên</a>
</div>

@if (TempData[StaffAccountsController.IssuedPasswordKey] is string issuedPassword)
{
    <div class="alert alert-success" role="alert">
        Đã đặt lại mật khẩu về số điện thoại của nhân viên: <code style="font-size:1.25rem">@issuedPassword</code><br />
        Nhân viên đăng nhập bằng Gmail @(string.IsNullOrEmpty(Model.Email) ? string.Empty : $"({Model.Email})") và mật khẩu này, rồi bắt buộc đổi mật khẩu mới.
    </div>
}
@if (string.IsNullOrEmpty(Model.Email))
{
    <div class="alert alert-warning" role="alert">
        Tài khoản này được tạo trước khi dùng Gmail và vẫn đăng nhập bằng số điện thoại. Hãy nhập Gmail của nhân viên bên dưới để chuyển sang đăng nhập bằng Gmail.
    </div>
}

<div class="admin-order-grid mb-4">
    <section class="admin-detail-card">
        <h3>Thông tin nhân viên</h3>
        <form asp-area="Admin" asp-controller="StaffAccounts" asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" maxlength="256" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type="email" inputmode="email" autocapitalize="none" spellcheck="false" maxlength="256" placeholder="ten.nhanvien@gmail.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
                <div class="form-text">Đổi Gmail cũng đổi tên đăng nhập của nhân viên.</div>
            </div>
            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" type="tel" inputmode="tel" maxlength="20" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                <div class="form-text">Đổi số điện thoại không đổi mật khẩu hiện tại; số mới chỉ thành mật khẩu khi bạn đặt lại mật khẩu.</div>
            </div>
            <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Lưu thay đổi</button>
        </form>
    </section>

    <section class="admin-detail-card">
        <h3>Đăng nhập &amp; mật khẩu</h3>
        <div class="admin-detail-row">
            <span>Trạng thái</span>
            @if (Model.IsLocked)
            {
                <span class="admin-status status-cancelled">Đã khóa</span>
            }
            else if (Model.MustChangePassword)
            {
                <span class="admin-status status-pending">Chưa đổi mật khẩu tạm</span>
            }
            else
            {
                <span class="admin-status status-completed">Đang hoạt động</span>
            }
        </div>
        @if (!Model.IsLocked)
        {
            <div class="admin-detail-row"><span>Tên đăng nhập</span><span>@(string.IsNullOrEmpty(Model.Email) ? Model.PhoneNumber : Model.Email)</span></div>
            <p class="admin-stat-note mt-3">Khi nhân viên quên mật khẩu, đặt lại mật khẩu về số điện thoại của nhân viên (@Model.PhoneNumber). Mật khẩu cũ hết hiệu lực, nhân viên bị đăng xuất và phải đổi mật khẩu ở lần đăng nhập kế tiếp.</p>
            <form asp-area="Admin" asp-controller="StaffAccounts" asp-action="ResetPassword" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('Đặt lại mật khẩu của @Model.FullName về số điện thoại? Mật khẩu hiện tại sẽ không dùng được nữa.');">
                <button type="submit" class="btn btn-outline-primary"><i class="fa fa-key"></i>Đặt lại mật khẩu về số điện thoại</button>
            </form>
        }
    </section>
</div>

<section class="admin-detail-card mb-4">
    <h3>Quyền của nhân viên trên hệ thống</h3>
    <partial name="_StaffPermissions" />
</section>

<section class="admin-detail-card @(Model.IsLocked ? "admin-danger-zone" : string.Empty)">
    <h3>Khóa tài khoản</h3>
    @if (Model.IsLocked)
    {
        <div class="admin-detail-row"><span>Lý do khóa</span><span>@(Model.LockReason ?? "Không ghi lý do")</span></div>
        <form asp-area="Admin" asp-controller="StaffAccounts" asp-action="Unlock" asp-route-id="@Model.Id" method="post" class="mt-3">
            <button type="submit" class="btn btn-success"><i class="fa fa-unlock me-2"></i>Mở khóa tài khoản</button>
        </form>
    }
    else
    {
        <p class="admin-stat-note">Khóa khi nhân viên nghỉ việc hoặc tạm ngừng làm việc. Nhân viên bị khóa sẽ bị đăng xuất và không thể vào khu vực quản lý; dữ liệu đã xử lý (đơn hàng, tin nhắn) vẫn được giữ nguyên.</p>
        <form asp-area="Admin" asp-controller="StaffAccounts" asp-action="Lock" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('Khóa tài khoản @Model.FullName?');">
            <label for="lock-reason" class="form-label">Lý do khóa</label>
            <div class="admin-actions">
                <input id="lock-reason" name="reason" class="form-control" maxlength="500" required style="max-width:520px" placeholder="VD: Nghỉ việc từ 01/12/2026" />
                <button type="submit" class="btn btn-outline-danger"><i class="fa fa-lock me-2"></i>Khóa tài khoản</button>
            </div>
        </form>
    }
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
