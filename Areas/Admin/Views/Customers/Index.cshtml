@model PopPop.Models.CustomerListViewModel
@{
    ViewData["Title"] = "Quản lý khách hàng";
    var first = Model.TotalCount == 0 ? 0 : (Model.PageNumber - 1) * Model.PageSize + 1;
    var last = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount);
}
<div class="admin-page-heading">
    <div><h2>Danh sách khách hàng</h2><p>Theo dõi khách hàng, lịch sử mua hàng và trạng thái tài khoản.</p></div>
</div>
<form class="admin-toolbar" method="get">
    <input class="form-control" type="search" name="search" value="@Model.Search" placeholder="Tên, email hoặc số điện thoại" aria-label="Tìm khách hàng" />
    <select class="form-select" name="status" aria-label="Lọc theo trạng thái">
        <option value="">Tất cả trạng thái</option>
        <option value="active" selected="@(Model.Status == "active")">Đang hoạt động</option>
        <option value="locked" selected="@(Model.Status == "locked")">Đã khóa</option>
    </select>
    <select class="form-select" name="sort" aria-label="Sắp xếp">
        <option value="newest" selected="@(Model.Sort == "newest")">Đăng ký mới nhất</option>
        <option value="spent" selected="@(Model.Sort == "spent")">Chi tiêu nhiều nhất</option>
        <option value="orders" selected="@(Model.Sort == "orders")">Nhiều đơn nhất</option>
        <option value="recent-order" selected="@(Model.Sort == "recent-order")">Mua gần đây nhất</option>
        <option value="name" selected="@(Model.Sort == "name")">Tên A–Z</option>
    </select>
    <button class="btn btn-primary" type="submit"><i class="fa fa-search me-1"></i>Lọc</button>
    <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Customers" asp-action="Index">Xóa lọc</a>
</form>
<div class="admin-panel">
    <div class="admin-panel-header"><h3>@Model.TotalCount khách hàng</h3>@if (Model.TotalCount > 0) { <span class="admin-stat-note">Hiển thị @first–@last</span> }</div>
    @if (Model.Customers.Count == 0)
    {
        <div class="admin-empty">Không có khách hàng phù hợp.</div>
    }
    else
    {
        <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Khách hàng</th><th>Email</th><th>Điện thoại</th><th>Ngày đăng ký</th><th>Số đơn</th><th>Đã chi tiêu</th><th>Mua gần nhất</th><th>Trạng thái</th><th></th></tr></thead><tbody>
        @foreach (var customer in Model.Customers)
        {
            <tr>
                <td>
                    <a class="admin-link" asp-area="Admin" asp-controller="Customers" asp-action="Details" asp-route-id="@customer.Id">@(string.IsNullOrWhiteSpace(customer.FullName) ? "(Chưa có tên)" : customer.FullName)</a>
                </td>
                <td>
                    @if (customer.Email is null)
                    {
                        <text>—</text>
                    }
                    else
                    {
                        @customer.Email
                        @if (!customer.EmailConfirmed)
                        {
                            <br /><span class="admin-stat-note">Chưa xác thực</span>
                        }
                    }
                </td>
                <td>@(customer.PhoneNumber ?? "—")</td>
                <td>@customer.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                <td>@customer.OrderCount</td>
                <td>@customer.TotalSpent.ToString("N0") ₫</td>
                <td>@(customer.LastOrderAt?.ToLocalTime().ToString("dd/MM/yyyy") ?? "Chưa mua")</td>
                <td>
                    @if (customer.IsLocked)
                    {
                        <span class="admin-status status-cancelled">Đã khóa</span>
                    }
                    else
                    {
                        <span class="admin-status status-completed">Hoạt động</span>
                    }
                </td>
                <td><a class="btn btn-sm btn-outline-primary" asp-area="Admin" asp-controller="Customers" asp-action="Details" asp-route-id="@customer.Id">Chi tiết</a></td>
            </tr>
        }
        </tbody></table></div>
    }
</div>
@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Phân trang khách hàng">
        <ul class="pagination">
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.PageNumber ? "active" : string.Empty)">
                    <a class="page-link" asp-area="Admin" asp-controller="Customers" asp-action="Index" asp-route-page="@pageNumber"
                       asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort">@pageNumber</a>
                </li>
            }
        </ul>
    </nav>
}
