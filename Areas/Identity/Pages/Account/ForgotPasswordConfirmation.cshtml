@page
@model ForgotPasswordConfirmationModel
@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = "Kiểm tra email của bạn";
}

<div class="row">
    <div class="col-12">
        <h1>@ViewData["Title"]</h1>
        <hr />
        @if (Model.Delivered)
        {
            <p>
                Nếu <strong>@(string.IsNullOrEmpty(Model.Email) ? "email bạn nhập" : Model.Email)</strong> là email của một tài khoản PôpPôp,
                chúng tôi đã gửi tới đó một liên kết xác nhận. Mở email và bấm <strong>"Đặt mật khẩu mới"</strong> để tiếp tục.
            </p>
            <p class="text-muted">Không thấy email? Hãy kiểm tra thư mục Spam/Quảng cáo. Liên kết chỉ dùng được một lần và có hiệu lực trong 24 giờ.</p>
        }
        else
        {
            <div class="alert alert-warning" role="alert">
                Hiện chưa gửi được email đặt lại mật khẩu. Vui lòng
                <a asp-page="./ForgotPassword" asp-route-email="@Model.Email">thử lại</a> sau ít phút.
            </div>
        }

        @if (Model.DevResetUrl is not null)
        {
            <div class="alert alert-info" role="alert">
                <strong>Môi trường phát triển:</strong> chưa cấu hình SMTP nên email không được gửi thật.
                <a href="@Model.DevResetUrl">Bấm vào đây để đặt mật khẩu mới</a>.
            </div>
        }

        <div class="identity-account-links">
            <p><a asp-page="./Login">Quay lại đăng nhập</a></p>
            <p><a asp-page="./ForgotPassword" asp-route-email="@Model.Email">Gửi lại email</a></p>
        </div>
    </div>
</div>
