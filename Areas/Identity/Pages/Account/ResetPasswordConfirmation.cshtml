@page
@model ResetPasswordConfirmationModel
@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = "Đã đổi mật khẩu";
}

<div class="row">
    <div class="col-12">
        <h1>@ViewData["Title"]</h1>
        <hr />
        <div class="alert alert-success" role="alert">
            Mật khẩu của bạn đã được đặt lại. Hãy đăng nhập bằng mật khẩu mới.
        </div>
        <div class="identity-account-links">
            @if (Model.Management)
            {
                <p><a asp-page="./AdminLogin">Đến trang đăng nhập quản trị</a></p>
            }
            else
            {
                <p><a asp-page="./Login">Đến trang đăng nhập</a></p>
            }
        </div>
    </div>
</div>
