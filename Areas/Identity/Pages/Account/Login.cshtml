@page "/login"
@model LoginModel

@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = "Đăng nhập";
}

<div class="row">
    <div class="col-12">
        <section>
            <form id="account" method="post">
                <h1>@ViewData["Title"]</h1>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                @if (Model.UnconfirmedEmail is not null)
                {
                    <div class="alert alert-warning" role="alert">
                        Tài khoản <strong>@Model.UnconfirmedEmail</strong> chưa xác thực email nên chưa thể đăng nhập.
                        @if (Model.ConfirmationEmailDelivered)
                        {
                            <text>Chúng tôi vừa gửi lại email xác thực, vui lòng kiểm tra hộp thư (kể cả thư mục Spam) và bấm "Xác thực email".</text>
                        }
                        else
                        {
                            <text>Hiện chưa gửi được email xác thực, vui lòng thử lại sau ít phút.</text>
                        }
                        @if (Model.DevConfirmationUrl is not null)
                        {
                            <br /><span><strong>Môi trường phát triển (chưa cấu hình SMTP):</strong> <a href="@Model.DevConfirmationUrl">bấm vào đây để xác thực</a>.</span>
                        }
                    </div>
                }
                <div class="form-floating mb-3">
                    <input asp-for="Input.Login" class="form-control" type="text" inputmode="email" autocomplete="username" aria-required="true" placeholder="ban@example.com" />
                    <label asp-for="Input.Login" class="form-label">Email</label>
                    <span asp-validation-for="Input.Login" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Nhập mật khẩu" />
                    <label asp-for="Input.Password" class="form-label">Mật khẩu</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="checkbox mb-3">
                    <label asp-for="Input.RememberMe" class="form-label">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        Ghi nhớ đăng nhập
                    </label>
                </div>
                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Đăng nhập</button>
                </div>
                <div class="identity-account-links">
                    <p>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Tạo tài khoản mới.</a>
                    </p>
                    <p>
                        <a asp-page="./ResendEmailConfirmation">Gửi lại email xác thực.</a>
                    </p>
                    <p class="text-muted">
                        Quên mật khẩu? Vui lòng liên hệ cửa hàng (hotline hoặc trực tiếp tại cửa hàng) để được đặt lại mật khẩu tạm thời.
                    </p>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
