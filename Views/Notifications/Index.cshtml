@model PopPop.Models.NotificationListViewModel
@using PopPop.Services.Implementations
@{
    ViewData["Title"] = "Thông báo";
}
<section class="section_gap">
    <div class="container" style="max-width:820px">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <div>
                <h2 class="mb-1">Thông báo</h2>
                <p class="text-muted mb-0">@(Model.UnreadCount > 0 ? $"{Model.UnreadCount} thông báo chưa đọc" : "Bạn đã đọc hết thông báo")</p>
            </div>
            @if (Model.UnreadCount > 0)
            {
                <form asp-controller="Notifications" asp-action="MarkAllRead" method="post">
                    <button type="submit" class="btn btn-outline-primary">Đánh dấu tất cả đã đọc</button>
                </form>
            }
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="alert alert-info">Chưa có thông báo nào. Khi cửa hàng cập nhật yêu cầu bảo hành/đổi hàng của bạn, thông báo sẽ xuất hiện tại đây.</div>
        }
        else
        {
            <div class="list-group">
                @foreach (var item in Model.Items)
                {
                    <a class="list-group-item list-group-item-action @(item.IsRead ? string.Empty : "list-group-item-warning")" asp-controller="Notifications" asp-action="Open" asp-route-id="@item.Id">
                        <div class="d-flex justify-content-between">
                            <strong>@(item.IsRead ? string.Empty : "● ")@item.Title</strong>
                            <small class="text-muted">@ShopClock.ToLocal(item.CreatedAt).ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.Message)) { <div class="text-muted">@item.Message</div> }
                    </a>
                }
            </div>
            @if (Model.TotalPages > 1)
            {
                <nav class="mt-3"><ul class="pagination">
                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.PageNumber ? "active" : string.Empty)"><a class="page-link" asp-controller="Notifications" asp-action="Index" asp-route-page="@pageNumber">@pageNumber</a></li>
                    }
                </ul></nav>
            }
        }
    </div>
</section>
