@model IReadOnlyList<PopPop.Models.ClaimRowViewModel>
@using PopPop.Data.Entities.Enums
@using PopPop.Services.Implementations
@{
    ViewData["Title"] = "Bảo hành & đổi hàng";
}
<section class="section_gap">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
            <h2 class="mb-0">Yêu cầu bảo hành & đổi hàng của tôi</h2>
            <a asp-controller="Claims" asp-action="Start" class="primary-btn">Tạo yêu cầu bảo hành</a>
        </div>
        <p class="text-muted">Chọn sản phẩm trong đơn hàng đã giao thành công để gửi yêu cầu kèm video minh chứng. Cửa hàng chỉ đổi sản phẩm mới hoặc từ chối, không hoàn tiền.</p>
        @if (Model.Count == 0)
        {
            <div class="alert alert-info">Bạn chưa có yêu cầu nào. <a asp-controller="Orders" asp-action="Index">Xem đơn hàng của tôi</a></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead><tr><th>Mã yêu cầu</th><th>Ngày gửi</th><th>Sản phẩm</th><th>Loại</th><th>Trạng thái</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var claim in Model)
                        {
                            <tr>
                                <td><strong>@claim.Code</strong><br /><small class="text-muted">Đơn @claim.OrderCode</small></td>
                                <td>@ShopClock.ToLocal(claim.CreatedAt).ToString("dd/MM/yyyy")</td>
                                <td>@claim.ProductName<br /><small class="text-muted">@claim.DefectName</small></td>
                                <td>@ClaimDisplay.TypeText(claim.Type)</td>
                                <td><span class="badge @(claim.Status == ClaimStatus.Completed ? "badge-success" : ClaimDisplay.IsClosed(claim.Status) ? "badge-secondary" : "badge-warning")">@ClaimDisplay.StatusText(claim.Status)</span></td>
                                <td><a asp-controller="Claims" asp-action="Details" asp-route-id="@claim.Id" class="btn btn-sm btn-outline-primary">Xem</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
