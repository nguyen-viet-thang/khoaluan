@model PopPop.Models.ClaimDetailsViewModel
@using PopPop.Data.Entities.Enums
@using PopPop.Services.Implementations
@{
    ViewData["Title"] = $"Yêu cầu {Model.Code}";
    var limits = Model.Limits;
}
<section class="section_gap">
    <div class="container" style="max-width:960px">
        @if (TempData["ClaimSuccess"] is string success) { <div class="alert alert-success" role="alert">@success</div> }
        @if (TempData["ClaimError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }

        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <div>
                <h2 class="mb-1">Yêu cầu @Model.Code</h2>
                <span class="badge @(Model.Status == ClaimStatus.Completed ? "badge-success" : ClaimDisplay.IsClosed(Model.Status) ? "badge-secondary" : "badge-warning")">@ClaimDisplay.StatusText(Model.Status)</span>
                <span class="text-muted ml-2">@ClaimDisplay.TypeText(Model.Type) · gửi lúc @ShopClock.ToLocal(Model.CreatedAt).ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <a asp-controller="Claims" asp-action="Index" class="btn btn-outline-primary">Yêu cầu của tôi</a>
        </div>

        @if (Model.Status == ClaimStatus.NeedMoreInfo)
        {
            <div class="alert alert-warning">Cửa hàng cần thêm minh chứng. Xem lời nhắn trong mục "Tiến trình xử lý" và gửi bổ sung bên dưới.</div>
        }
        @if (Model.Status == ClaimStatus.Approved)
        {
            <div class="card mb-3 border-info">
                <div class="card-body">
                    <h5 class="card-title">Gửi sản phẩm về cửa hàng</h5>
                    <p class="mb-2">Yêu cầu đã được duyệt. Đóng gói sản phẩm giữ nguyên tình trạng (với vợt <strong>không cắt dây</strong>), kèm phụ kiện/tem đi kèm và ghi mã yêu cầu <strong>@Model.Code</strong> bên ngoài gói hàng.</p>
                    @if (Model.ShopAddress is not null)
                    {
                        <p class="mb-2"><strong>Địa chỉ nhận:</strong> @Model.ShopAddress@(Model.ShopHotline is not null ? $" · ĐT {Model.ShopHotline}" : string.Empty)</p>
                    }
                    else
                    {
                        <p class="mb-2"><strong>Địa chỉ nhận:</strong> xem lời nhắn của cửa hàng trong mục "Tiến trình xử lý".</p>
                    }
                    @if (Model.ReturnShippedAt is { } shippedAt)
                    {
                        <div class="alert alert-success mb-2">Bạn đã báo gửi hàng @ClaimDisplay.ShipmentText(Model.ReturnCarrier, Model.ReturnTrackingCode) lúc @ShopClock.ToLocal(shippedAt).ToString("dd/MM HH:mm"). Cửa hàng sẽ báo khi nhận được.</div>
                    }
                    @if (Model.CanReportShipment)
                    {
                        <form asp-controller="Claims" asp-action="ReportShipment" asp-route-id="@Model.Id" method="post" class="form-row align-items-end">
                            <div class="col-md-5 form-group mb-2">
                                <label for="carrier">Đơn vị vận chuyển</label>
                                <input id="carrier" name="Carrier" class="form-control" list="carrier-list" maxlength="100" required value="@Model.ReturnCarrier" placeholder="VD: Giao Hàng Nhanh (GHN)" />
                                <datalist id="carrier-list">
                                    @foreach (var carrier in ClaimDisplay.Carriers) { <option value="@carrier"></option> }
                                    <option value="@ClaimDisplay.InPerson"></option>
                                </datalist>
                            </div>
                            <div class="col-md-4 form-group mb-2">
                                <label for="tracking">Mã vận đơn</label>
                                <input id="tracking" name="TrackingCode" class="form-control" maxlength="100" value="@Model.ReturnTrackingCode" placeholder="Bỏ trống nếu mang tới cửa hàng" />
                            </div>
                            <div class="col-md-3 form-group mb-2">
                                <button type="submit" class="primary-btn w-100">@(Model.ReturnShippedAt.HasValue ? "Cập nhật" : "Tôi đã gửi hàng")</button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        }
        @if (Model.Status == ClaimStatus.ReturningToCustomer)
        {
            <div class="card mb-3 border-success">
                <div class="card-body">
                    <h5 class="card-title">Sản phẩm thay thế đang được gửi cho bạn</h5>
                    <p class="mb-2">Gửi @ClaimDisplay.ShipmentText(Model.OutboundCarrier, Model.OutboundTrackingCode)@(Model.OutboundShippedAt is { } outAt ? $" lúc {ShopClock.ToLocal(outAt):dd/MM HH:mm}" : string.Empty), tới: @Model.DeliveryName · @Model.DeliveryPhone · @Model.DeliveryAddress</p>
                    @if (Model.CanConfirmReceived)
                    {
                        <form asp-controller="Claims" asp-action="ConfirmReceived" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Xác nhận bạn đã nhận được sản phẩm thay thế?');">
                            <button type="submit" class="primary-btn">Đã nhận hàng</button>
                        </form>
                    }
                </div>
            </div>
        }
        @if (Model.Status == ClaimStatus.Rejected && Model.OutboundShippedAt.HasValue)
        {
            <div class="alert alert-secondary">Sản phẩm của bạn được gửi trả @ClaimDisplay.ShipmentText(Model.OutboundCarrier, Model.OutboundTrackingCode).</div>
        }
        @if (Model.Resolution is { } resolution)
        {
            <div class="alert alert-success">Kết quả: <strong>@ClaimDisplay.ResolutionText(resolution)</strong></div>
        }

        <div class="row">
            <div class="col-md-6">
                <h4>Thông tin yêu cầu</h4>
                <p><strong>Sản phẩm:</strong> @Model.ProductName (@Model.SKU) × @Model.Quantity</p>
                <p><strong>Đơn hàng:</strong> <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId">@Model.OrderCode</a> · giao ngày @ShopClock.ToLocal(Model.DeliveredAt).ToString("dd/MM/yyyy")</p>
                <p><strong>Lỗi:</strong> @Model.DefectCode – @Model.DefectName</p>
                @if (!string.IsNullOrWhiteSpace(Model.SerialNumber)) { <p><strong>Số serial:</strong> @Model.SerialNumber</p> }
                <p><strong>Mô tả:</strong><br /><span style="white-space:pre-line">@Model.Description</span></p>
            </div>
            <div class="col-md-6">
                <h4>Tiến trình xử lý</h4>
                <ul class="list-group">
                    @foreach (var entry in Model.History)
                    {
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between"><strong>@(entry.IsUpdate ? (entry.ByStaff ? "Lời nhắn của cửa hàng" : "Cập nhật") : ClaimDisplay.StatusText(entry.ToStatus))</strong><small class="text-muted">@ShopClock.ToLocal(entry.CreatedAt).ToString("dd/MM HH:mm")</small></div>
                            <small class="text-muted">@entry.ActorName</small>
                            @if (!string.IsNullOrWhiteSpace(entry.Note)) { <div style="white-space:pre-line">@entry.Note</div> }
                        </li>
                    }
                </ul>
            </div>
        </div>

        <h4 class="mt-4">Minh chứng đã gửi (@Model.Media.Count)</h4>
        <div class="row">
            @foreach (var media in Model.Media)
            {
                <div class="col-md-6 mb-3">
                    @if (media.Kind == ClaimMediaKind.Video)
                    {
                        <video controls preload="metadata" style="width:100%;max-height:360px;background:#000" src="@Url.Action("Media", "Claims", new { id = media.Id })"></video>
                    }
                    else
                    {
                        <img src="@Url.Action("Media", "Claims", new { id = media.Id })" alt="@media.OriginalFileName" style="width:100%;max-height:360px;object-fit:contain" />
                    }
                    <small class="text-muted">@media.OriginalFileName · @ClaimDisplay.FileSize(media.SizeBytes) · @ShopClock.ToLocal(media.UploadedAt).ToString("dd/MM HH:mm")</small>
                </div>
            }
        </div>

        @if (Model.CanAddEvidence)
        {
            <div class="card mt-3">
                <div class="card-body">
                    <h5>Gửi minh chứng bổ sung</h5>
                    <form asp-controller="Claims" asp-action="AddEvidence" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                        <div class="form-group">
                            <input type="file" name="files" class="form-control" multiple required accept="@limits.VideoExtensions,@limits.ImageExtensions,video/*,image/*" />
                            <small class="text-muted">Tối đa @limits.MaxVideos video (≤ @(limits.MaxVideoBytes / 1024 / 1024) MB) và @limits.MaxImages ảnh mỗi lần.</small>
                        </div>
                        <div class="form-group">
                            <textarea name="note" class="form-control" rows="2" maxlength="1000" placeholder="Ghi chú thêm cho cửa hàng (không bắt buộc)"></textarea>
                        </div>
                        <button type="submit" class="primary-btn">Gửi bổ sung</button>
                    </form>
                </div>
            </div>
        }

        @if (Model.CanCancel)
        {
            <form asp-controller="Claims" asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="mt-3" onsubmit="return confirm('Hủy yêu cầu @Model.Code?');">
                <button type="submit" class="btn btn-outline-danger">Hủy yêu cầu</button>
            </form>
        }
    </div>
</section>
