@model PopPop.Models.HomeViewModel
@inject Microsoft.Extensions.Options.IOptions<PopPop.Models.ShippingOptions> ShippingOptionsAccessor
@{
    Layout = "_Layout";
    ViewData["Title"] = "Trang chủ";
    var shipping = ShippingOptionsAccessor.Value;
    string Shorten(string? text, int max)
    {
        if (string.IsNullOrWhiteSpace(text) || text.Length <= max)
        {
            return text ?? string.Empty;
        }

        var cut = text.LastIndexOf(' ', max);
        return text[..(cut > 0 ? cut : max)] + "…";
    }
}

<!-- Hero: featured products from the catalog -->
<section class="banner-area">
    <div class="container">
        <div class="row fullscreen align-items-center justify-content-start">
            <div class="col-lg-12">
                @if (Model.Featured.Count == 0)
                {
                    <div class="banner-content store-hero__content">
                        <h1>Dụng cụ cầu lông<br />chính hãng</h1>
                        <p>Vợt, giày, quần áo, quả cầu và phụ kiện cho tập luyện và thi đấu.</p>
                        <a asp-controller="Products" asp-action="Index" class="primary-btn">Mua sắm ngay</a>
                    </div>
                }
                else
                {
                    <div class="active-banner-slider owl-carousel">
                        @foreach (var item in Model.Featured)
                        {
                            <div class="row single-slide align-items-center d-flex">
                                <div class="col-lg-5 col-md-6">
                                    <div class="banner-content store-hero__content">
                                        @if (!string.IsNullOrWhiteSpace(item.CategoryName))
                                        {
                                            <span class="store-hero__eyebrow">@item.CategoryName</span>
                                        }
                                        <h1>@item.Name</h1>
                                        <p>@Shorten(item.Description, 160)</p>
                                        <p class="store-hero__price">Giá từ <strong>@item.Price.ToString("N0") ₫</strong></p>
                                        <div class="d-flex flex-wrap store-hero__actions">
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id" class="primary-btn">Xem chi tiết</a>
                                            <a asp-controller="Products" asp-action="Index" class="store-hero__link">Xem tất cả sản phẩm <span class="lnr lnr-arrow-right"></span></a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-7 col-md-6">
                                    <div class="store-hero__image">
                                        <img src="@Url.Content(item.ImageUrl ?? "~/img/logo.png")" alt="@item.Name" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Shop policies (real behaviour of the system) -->
<section class="features-area section_gap">
    <div class="container">
        <div class="row features-inner">
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="single-features">
                    <div class="f-icon store-feature__icon"><i class="fa fa-truck" aria-hidden="true"></i></div>
                    <h6>Giao hàng toàn quốc</h6>
                    <p>
                        @if (shipping.Fee == 0)
                        {
                            <text>Miễn phí giao hàng mọi đơn</text>
                        }
                        else if (shipping.FreeShippingThreshold > 0)
                        {
                            <text>Miễn phí cho đơn từ @shipping.FreeShippingThreshold.ToString("N0") ₫</text>
                        }
                        else
                        {
                            <text>Phí giao hàng @shipping.Fee.ToString("N0") ₫</text>
                        }
                    </p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="single-features">
                    <div class="f-icon store-feature__icon"><i class="fa fa-money" aria-hidden="true"></i></div>
                    <h6>Thanh toán khi nhận hàng</h6>
                    <p>Kiểm tra hàng rồi mới thanh toán (COD)</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="single-features">
                    <div class="f-icon store-feature__icon"><i class="fa fa-check-circle" aria-hidden="true"></i></div>
                    <h6>Hàng chính hãng</h6>
                    <p>@(Model.Brands.Count > 0 ? string.Join(", ", Model.Brands.Select(brand => brand.Name)) : "Từ các thương hiệu uy tín")</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="single-features">
                    <div class="f-icon store-feature__icon"><i class="fa fa-shield" aria-hidden="true"></i></div>
                    <h6>Bảo hành trực tuyến</h6>
                    <p>Gửi yêu cầu bảo hành ngay trên website</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categories from the database -->
@if (Model.Categories.Count > 0)
{
    <section class="section_gap_bottom" id="categories">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-6 text-center">
                    <div class="section-title">
                        <h1>Danh mục sản phẩm</h1>
                        <p>Chọn nhanh theo nhu cầu tập luyện và thi đấu.</p>
                    </div>
                </div>
            </div>
            <div class="store-category-grid">
                @foreach (var category in Model.Categories)
                {
                    <a class="store-category-card" asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.Id">
                        <span class="store-category-card__image">
                            <img src="@Url.Content(category.ImageUrl ?? "~/img/logo.png")" alt="" loading="lazy" />
                        </span>
                        <span class="store-category-card__name">@category.Name</span>
                        <span class="store-category-card__count">@category.ProductCount sản phẩm</span>
                    </a>
                }
            </div>
        </div>
    </section>
}

<!-- Newest products -->
<section class="section_gap_bottom" id="products">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 text-center">
                <div class="section-title">
                    <h1>Sản phẩm mới</h1>
                    <p>Những mẫu vừa về cửa hàng.</p>
                </div>
            </div>
        </div>
        <div class="row">
            @if (Model.LatestProducts.Count == 0)
            {
                <div class="col-12 text-center"><p>Hiện chưa có sản phẩm nào đang bán.</p></div>
            }
            @foreach (var product in Model.LatestProducts)
            {
                <div class="col-lg-3 col-md-4 col-6">
                    <partial name="_ProductCard" model="product" />
                </div>
            }
        </div>
        <div class="text-center">
            <a asp-controller="Products" asp-action="Index" class="primary-btn">Xem tất cả sản phẩm</a>
        </div>
    </div>
</section>

<!-- Best sellers: only shown once the shop has real sales -->
@if (Model.BestSellers.Count > 0)
{
    <section class="section_gap_bottom">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-6 text-center">
                    <div class="section-title">
                        <h1>Bán chạy</h1>
                        <p>Được khách hàng đặt mua nhiều nhất.</p>
                    </div>
                </div>
            </div>
            <div class="row">
                @foreach (var product in Model.BestSellers)
                {
                    <div class="col-lg-3 col-md-4 col-6">
                        <partial name="_ProductCard" model="product" />
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Brands from the database -->
@if (Model.Brands.Count > 0)
{
    <section class="section_gap_bottom">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-6 text-center">
                    <div class="section-title">
                        <h1>Thương hiệu</h1>
                        <p>Sản phẩm chính hãng từ các thương hiệu cầu lông hàng đầu.</p>
                    </div>
                </div>
            </div>
            <div class="store-brand-grid">
                @foreach (var brand in Model.Brands)
                {
                    <a class="store-brand-card" asp-controller="Products" asp-action="Index" asp-route-brandId="@brand.Id">
                        <span class="store-brand-card__name">@brand.Name</span>
                        <span class="store-brand-card__desc">@Shorten(brand.Description, 110)</span>
                        <span class="store-brand-card__count">@brand.ProductCount sản phẩm <span class="lnr lnr-arrow-right"></span></span>
                    </a>
                }
            </div>
        </div>
    </section>
}

@section Styles {
    <link rel="stylesheet" href="~/css/main.css" />
}
@section Scripts {
    <script src="~/js/main.js"></script>
}
