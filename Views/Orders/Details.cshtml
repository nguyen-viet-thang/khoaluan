@model PopPop.Models.OrderDetailsViewModel
@using PopPop.Data.Entities.Enums

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    var statusText = Model.Status switch
    {
        OrderStatus.Pending => "Chờ xác nhận",
        OrderStatus.Confirmed => "Đã xác nhận",
        OrderStatus.Processing => "Đang xử lý",
        OrderStatus.Shipping => "Đang giao hàng",
        OrderStatus.Completed => "Đã giao thành công",
        OrderStatus.Cancelled => "Đã hủy",
        _ => Model.Status.ToString()
    };
    var trackingSteps = new[]
    {
        (Status: OrderStatus.Pending, Title: "Đã tiếp nhận đơn hàng"),
        (Status: OrderStatus.Confirmed, Title: "Nhân viên đã xác nhận"),
        (Status: OrderStatus.Processing, Title: "Đang chuẩn bị hàng"),
        (Status: OrderStatus.Shipping, Title: "Đang giao hàng"),
        (Status: OrderStatus.Completed, Title: "Đã giao thành công")
    };
    var currentStep = Array.FindIndex(trackingSteps, step => step.Status == Model.Status);
}

<section class="section_gap">
    <div class="container">
        @if (TempData["OrderSuccess"] is string orderSuccess)
        {
            <div class="alert alert-success" role="alert">@orderSuccess</div>
        }
        @if (TempData["OrderError"] is string orderError)
        {
            <div class="alert alert-danger" role="alert">@orderError</div>
        }
        <div class="alert @(Model.Status == OrderStatus.Cancelled ? "alert-danger" : "alert-info")" role="status">
            Đơn hàng <strong>@Model.OrderCode</strong> — <strong>@statusText</strong>
        </div>

        @if (Model.PaymentDeadline is { } paymentDeadline)
        {
            var secondsLeft = Math.Max(0, (int)(paymentDeadline - DateTime.UtcNow).TotalSeconds);
            <div class="order-pay-card" id="order-pay-card" data-seconds-left="@secondsLeft">
                <div class="order-pay-card__info">
                    <i class="fa fa-clock-o" aria-hidden="true"></i>
                    <div>
                        <strong>Đơn hàng đang chờ thanh toán VNPAY: @Model.TotalAmount.ToString("N0") ₫</strong>
                        <span>
                            Vui lòng thanh toán trước @PopPop.Services.Implementations.ShopClock.ToLocal(paymentDeadline).ToString("HH:mm dd/MM")
                            (còn <b id="order-pay-countdown">@(secondsLeft / 60):@((secondsLeft % 60).ToString("00"))</b>). Quá hạn, đơn sẽ tự hủy và sản phẩm được trả lại kho.
                        </span>
                    </div>
                </div>
                <div class="order-pay-card__actions">
                    <a asp-controller="Orders" asp-action="Pay" asp-route-id="@Model.Id" class="primary-btn" id="order-pay-now">Thanh toán ngay</a>
                    <form asp-controller="Orders" asp-action="SwitchToCod" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Chuyển đơn @Model.OrderCode sang thanh toán khi nhận hàng (COD)?');">
                        <button type="submit" class="btn btn-outline-secondary">Đổi sang COD</button>
                    </form>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-6">
                <h4>Thông tin đơn hàng</h4>
                <p><strong>Trạng thái:</strong> @statusText</p>
                <p><strong>Ngày đặt:</strong> @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Cập nhật gần nhất:</strong> @Model.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Phương thức thanh toán:</strong> @(Model.PaymentMethod == PaymentMethod.VnPay ? "VNPAY" : "Thanh toán khi nhận hàng (COD)")</p>
                <p><strong>Trạng thái thanh toán:</strong> @(Model.PaymentStatus == PaymentStatus.Paid ? "Đã thanh toán" : Model.AwaitingOnlinePayment ? "Chờ thanh toán VNPAY" : "Chưa thanh toán")</p>
                @if (Model.PaidAt.HasValue)
                {
                    <p><strong>Thanh toán lúc:</strong> @Model.PaidAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                }
                <p><strong>Người nhận:</strong> @Model.RecipientName</p>
                <p><strong>Số điện thoại:</strong> @Model.RecipientPhone</p>
                <p><strong>Địa chỉ:</strong> @Model.ShippingAddress</p>
                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <p><strong>Ghi chú:</strong> @Model.Note</p>
                }
            </div>
            <div class="col-lg-6">
                <h4>Sản phẩm</h4>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.ProductName<br /><small>SKU: @item.SKU</small></td>
                                    <td>@item.UnitPrice.ToString("N0") ₫</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.LineTotal.ToString("N0") ₫</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Tạm tính</span>
                    <span>@Model.Items.Sum(item => item.LineTotal).ToString("N0") ₫</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Phí giao hàng</span>
                    <span>@(Model.ShippingFee == 0 ? "Miễn phí" : $"{Model.ShippingFee:N0} ₫")</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <strong>Tổng cộng</strong>
                    <strong>@Model.TotalAmount.ToString("N0") ₫</strong>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <h4>Tiến trình đơn hàng</h4>
            @if (Model.Status == OrderStatus.Cancelled)
            {
                <div class="alert alert-danger">Đơn hàng đã bị hủy. Vui lòng liên hệ cửa hàng nếu cần hỗ trợ.</div>
            }
            else
            {
                <ol class="list-group list-group-numbered">
                    @for (var index = 0; index < trackingSteps.Length; index++)
                    {
                        var step = trackingSteps[index];
                        var isReached = index <= currentStep;
                        <li class="list-group-item d-flex justify-content-between align-items-center @(isReached ? "list-group-item-success" : string.Empty)">
                            <span>@step.Title</span>
                            @if (step.Status == Model.Status)
                            {
                                <span class="badge bg-success rounded-pill">Hiện tại</span>
                            }
                            else if (isReached)
                            {
                                <span class="badge bg-success rounded-pill">Hoàn thành</span>
                            }
                        </li>
                    }
                </ol>
            }
            <p class="text-muted mt-2 mb-0">Trạng thái được cập nhật bởi nhân viên cửa hàng.</p>
        </div>

        @if (Model.CanCancel)
        {
            <div class="card mt-4">
                <div class="card-body">
                    <h5 class="card-title">Hủy đơn hàng</h5>
                    <p class="text-muted mb-3">Bạn có thể tự hủy khi cửa hàng chưa xác nhận đơn. Sau khi xác nhận, vui lòng liên hệ cửa hàng.</p>
                    <form asp-controller="Orders" asp-action="Cancel" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn hàng @Model.OrderCode?');">
                        <div class="form-group">
                            <label for="cancel-reason">Lý do hủy (không bắt buộc)</label>
                            <select id="cancel-reason" name="reason" class="form-control" style="max-width:420px">
                                <option value="">-- Chọn lý do --</option>
                                <option>Muốn thay đổi sản phẩm hoặc số lượng</option>
                                <option>Muốn thay đổi địa chỉ hoặc thông tin nhận hàng</option>
                                <option>Tìm được giá tốt hơn</option>
                                <option>Không còn nhu cầu mua</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-outline-danger">Hủy đơn hàng</button>
                    </form>
                </div>
            </div>
        }

        @if (Model.Status == OrderStatus.Completed || Model.Claims.Count > 0)
        {
            <div class="card mt-4">
                <div class="card-body">
                    <h5 class="card-title">Bảo hành &amp; đổi hàng</h5>
                    @if (Model.Claims.Count > 0)
                    {
                        <ul class="list-unstyled mb-3">
                            @foreach (var claim in Model.Claims)
                            {
                                <li class="mb-1">
                                    <a asp-controller="Claims" asp-action="Details" asp-route-id="@claim.Id"><strong>@claim.Code</strong></a>
                                    · @claim.ProductName · @ClaimDisplay.TypeText(claim.Type) ·
                                    <span class="badge @(claim.Status == ClaimStatus.Completed ? "badge-success" : ClaimDisplay.IsClosed(claim.Status) ? "badge-secondary" : "badge-warning")">@ClaimDisplay.StatusText(claim.Status)</span>
                                </li>
                            }
                        </ul>
                    }
                    @if (Model.Status == OrderStatus.Completed)
                    {
                        <p class="text-muted mb-2">Sản phẩm bị lỗi khi nhận hàng hoặc gặp lỗi thuộc diện bảo hành của hãng? Gửi yêu cầu kèm video minh chứng. Cửa hàng không đổi hàng vì không vừa ý.</p>
                        <a asp-controller="Claims" asp-action="Create" asp-route-orderId="@Model.Id" class="btn btn-outline-primary">Yêu cầu bảo hành / đổi hàng</a>
                    }
                </div>
            </div>
        }

        <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-primary mt-4">Đơn hàng của tôi</a>
        <a asp-controller="Home" asp-action="Index" class="primary-btn mt-4">Tiếp tục mua sắm</a>
    </div>
</section>

@if (Model.AwaitingOnlinePayment)
{
    <script>
        (function () {
            var card = document.getElementById('order-pay-card');
            var label = document.getElementById('order-pay-countdown');
            if (!card || !label) return;
            var left = parseInt(card.dataset.secondsLeft, 10) || 0;
            var timer = setInterval(function () {
                left = Math.max(0, left - 1);
                label.textContent = Math.floor(left / 60) + ':' + String(left % 60).padStart(2, '0');
                if (left === 0) {
                    clearInterval(timer);
                    card.classList.add('is-expired');
                    document.getElementById('order-pay-now')?.remove();
                    label.textContent = 'hết hạn';
                }
            }, 1000);
        })();
    </script>
}
