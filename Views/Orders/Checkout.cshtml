@model PopPop.Models.CheckoutViewModel
@using PopPop.Data.Entities.Enums

@{
    ViewData["Title"] = "Xác nhận đặt hàng";
}

<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Xác nhận đặt hàng</h1>
                <nav class="d-flex align-items-center">
                    <a asp-controller="Home" asp-action="Index">Trang chủ<span class="lnr lnr-arrow-right"></span></a>
                    <span>Thanh toán</span>
                </nav>
            </div>
        </div>
    </div>
</section>

<section class="checkout_area section_gap">
    <div class="container">
        <form asp-action="Checkout" method="post">
            <div class="billing_details">
                <div class="row">
                    <div class="col-lg-8">
                        <h3>Thông tin nhận hàng</h3>
                        <div asp-validation-summary="ModelOnly" class="col-md-12 text-danger"></div>
                        <div class="row contact_form">
                            <div class="col-md-12 form-group">
                                <label asp-for="RecipientName" class="sr-only"></label>
                                <input asp-for="RecipientName" class="form-control" placeholder="Tên người nhận *" autocomplete="name" />
                                <span asp-validation-for="RecipientName" class="text-danger"></span>
                            </div>
                            <div class="col-md-12 form-group">
                                <label asp-for="RecipientPhone" class="sr-only"></label>
                                <input asp-for="RecipientPhone" class="form-control" placeholder="Số điện thoại *" inputmode="tel" autocomplete="tel" />
                                <span asp-validation-for="RecipientPhone" class="text-danger"></span>
                            </div>
                            <div class="col-md-12 form-group">
                                <label asp-for="ShippingAddress" class="sr-only"></label>
                                <input asp-for="ShippingAddress" class="form-control" placeholder="Địa chỉ giao hàng (số nhà, đường, phường/xã, quận/huyện, tỉnh/thành) *" autocomplete="street-address" />
                                <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                            </div>
                            <div class="col-md-12 form-group">
                                <label asp-for="Note" class="sr-only"></label>
                                <textarea asp-for="Note" class="form-control" rows="3" placeholder="Ghi chú đơn hàng"></textarea>
                                <span asp-validation-for="Note" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="order_box">
                            <h2>Đơn hàng của bạn</h2>
                            @if (Model.Items.Count == 0)
                            {
                                <p class="text-danger">Giỏ hàng đang trống hoặc không còn sản phẩm khả dụng.</p>
                            }
                            else
                            {
                                <ul class="list">
                                    <li>
                                        <div class="d-flex justify-content-between py-2">
                                            <strong>Sản phẩm</strong>
                                            <strong>Thành tiền</strong>
                                        </div>
                                    </li>
                                    @foreach (var item in Model.Items)
                                    {
                                        <li>
                                            <div class="d-flex justify-content-between py-2">
                                                <span>@item.ProductName <span class="middle">× @item.Quantity</span></span>
                                                <span class="last">@item.LineTotal.ToString("N0") ₫</span>
                                            </div>
                                            <small class="d-block">@item.SKU · @item.UnitPrice.ToString("N0") ₫ / sản phẩm</small>
                                        </li>
                                    }
                                </ul>
                                <ul class="list list_2">
                                    <li><div class="d-flex justify-content-between py-2"><span>Tạm tính</span><span>@Model.Subtotal.ToString("N0") ₫</span></div></li>
                                    <li><div class="d-flex justify-content-between py-2"><span>Phí giao hàng</span><span>@(Model.ShippingFee == 0 ? "Miễn phí" : $"{Model.ShippingFee:N0} ₫")</span></div></li>
                                    <li><div class="d-flex justify-content-between py-2"><strong>Tổng cộng</strong><strong>@Model.TotalAmount.ToString("N0") ₫</strong></div></li>
                                </ul>
                                @if (Model.AmountToFreeShipping > 0)
                                {
                                    <p class="text-muted small mb-2">Mua thêm <strong>@Model.AmountToFreeShipping.ToString("N0") ₫</strong> để được miễn phí giao hàng (đơn từ @Model.FreeShippingThreshold.ToString("N0") ₫).</p>
                                }

                                <fieldset class="checkout-pay" aria-label="Phương thức thanh toán">
                                    <label class="checkout-pay__option">
                                        <input type="radio" name="PaymentMethod" value="@PaymentMethod.CashOnDelivery"
                                               checked="@(Model.PaymentMethod != PaymentMethod.VnPay || !Model.VnPayAvailable)" />
                                        <span class="checkout-pay__body">
                                            <strong><i class="fa fa-money" aria-hidden="true"></i> Thanh toán khi nhận hàng (COD)</strong>
                                            <small>Trả tiền mặt cho nhân viên giao hàng sau khi kiểm tra đủ sản phẩm.</small>
                                        </span>
                                    </label>
                                    <label class="checkout-pay__option @(Model.VnPayAvailable ? string.Empty : "is-disabled")">
                                        <input type="radio" name="PaymentMethod" value="@PaymentMethod.VnPay"
                                               checked="@(Model.PaymentMethod == PaymentMethod.VnPay && Model.VnPayAvailable)" disabled="@(!Model.VnPayAvailable)" />
                                        <span class="checkout-pay__body">
                                            <strong><i class="fa fa-credit-card" aria-hidden="true"></i> Thanh toán trực tuyến qua VNPAY</strong>
                                            @if (Model.VnPayAvailable)
                                            {
                                                <small>Thẻ ATM, Internet Banking, thẻ quốc tế hoặc QR. Đơn được giữ hàng trong @Model.VnPayTimeoutMinutes phút để bạn thanh toán.</small>
                                            }
                                            else
                                            {
                                                <small>Tạm thời chưa khả dụng.</small>
                                            }
                                        </span>
                                    </label>
                                </fieldset>
                                <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                                <button type="submit" class="primary-btn mt-3 w-100" id="checkout-submit"
                                        data-cod-text="Đặt hàng" data-vnpay-text="Đặt hàng &amp; thanh toán VNPAY">Đặt hàng</button>
                            }
                            <a asp-controller="Cart" asp-action="Index" class="d-block mt-3">Quay lại giỏ hàng</a>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var form = document.querySelector('.checkout_area form');
            var button = document.getElementById('checkout-submit');
            if (!form || !button) return;
            function syncLabel() {
                var vnpay = form.querySelector('input[name="PaymentMethod"][value="VnPay"]:checked');
                button.textContent = vnpay ? button.dataset.vnpayText : button.dataset.codText;
            }
            form.addEventListener('change', syncLabel);
            syncLabel();
            // One click = one order: block double submits while the request is in flight.
            form.addEventListener('submit', function () {
                if (window.jQuery && jQuery(form).valid && !jQuery(form).valid()) return;
                button.disabled = true;
                button.textContent = 'Đang xử lý...';
            });
        })();
    </script>
}
