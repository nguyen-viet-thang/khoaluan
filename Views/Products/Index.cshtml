@model ProductCatalogViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Sản phẩm";
    var startPage = Math.Max(1, Model.PageNumber - 2);
    var endPage = Math.Min(Model.TotalPages, startPage + 4);
    startPage = Math.Max(1, endPage - 4);
    var firstProductNumber = Model.TotalCount == 0 ? 0 : (Model.PageNumber - 1) * Model.PageSize + 1;
    var lastProductNumber = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount);
    var sliderMax = Math.Max(Model.PriceRangeMax, 1000m);
    var sliderMinValue = Math.Clamp(Model.MinPrice ?? 0m, 0m, sliderMax);
    var sliderMaxValue = Math.Clamp(Model.MaxPrice ?? sliderMax, 0m, sliderMax);
    if (sliderMinValue > sliderMaxValue)
    {
        sliderMinValue = sliderMaxValue;
    }

    var basePath = Url.Action("Index", "Products") ?? "/Products";
    string Link(Action<CatalogQuery> change) => Model.Query(change).ToUrl(basePath);
    var selectedOptions = Model.SpecFilters
        .SelectMany(group => group.Options.Where(option => option.Selected).Select(option => (Group: group.Name, Option: option)))
        .ToList();
    var categoryName = Model.Categories.FirstOrDefault(category => category.Id == Model.CategoryId)?.Name;
    var brandName = Model.Brands.FirstOrDefault(brand => brand.Id == Model.BrandId)?.Name;
    var hasActiveFilters = categoryName is not null || brandName is not null || Model.Search is not null
        || Model.MinPrice.HasValue || Model.MaxPrice.HasValue || selectedOptions.Count > 0;
}

<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Sản phẩm</h1>
                <nav class="d-flex align-items-center" aria-label="Breadcrumb">
                    <a asp-controller="Home" asp-action="Index">Trang chủ<span class="lnr lnr-arrow-right"></span></a>
                    <a asp-controller="Products" asp-action="Index">Danh mục sản phẩm</a>
                </nav>
            </div>
        </div>
    </div>
</section>

<div class="container section_gap">
    <div class="row">
        <aside class="col-xl-3 col-lg-4 col-md-5">
            <div class="sidebar-categories">
                <div class="head">Danh mục sản phẩm</div>
                <ul class="main-categories">
                    <li class="main-nav-list">
                        <a href="@Link(query => { query.CategoryId = null; query.Spec.Clear(); })"
                           aria-current="@(Model.CategoryId is null ? "page" : null)">Tất cả danh mục</a>
                    </li>
                    @foreach (var category in Model.Categories)
                    {
                        <li class="main-nav-list">
                            <a href="@Link(query => { query.CategoryId = category.Id; query.Spec.Clear(); })"
                               aria-current="@(Model.CategoryId == category.Id ? "page" : null)">@category.Name</a>
                        </li>
                    }
                </ul>
            </div>

            <div class="sidebar-categories mt-4">
                <div class="head">Thương hiệu</div>
                <ul class="main-categories">
                    <li class="main-nav-list">
                        <a href="@Link(query => query.BrandId = null)"
                           aria-current="@(Model.BrandId is null ? "page" : null)">Tất cả thương hiệu</a>
                    </li>
                    @foreach (var brand in Model.Brands)
                    {
                        <li class="main-nav-list">
                            <a href="@Link(query => query.BrandId = brand.Id)"
                               aria-current="@(Model.BrandId == brand.Id ? "page" : null)">@brand.Name</a>
                        </li>
                    }
                </ul>
            </div>

            @if (Model.SpecFilters.Count > 0)
            {
                <div class="sidebar-filter mt-4">
                    <div class="top-filter-head">Lọc theo thông số</div>
                    <form action="@basePath" method="get" data-auto-submit>
                        @if (Model.Search is not null) { <input type="hidden" name="q" value="@Model.Search" /> }
                        <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                        @if (Model.BrandId.HasValue) { <input type="hidden" name="brandId" value="@Model.BrandId" /> }
                        @if (Model.MinPrice.HasValue) { <input type="hidden" name="minPrice" value="@Model.MinPrice" /> }
                        @if (Model.MaxPrice.HasValue) { <input type="hidden" name="maxPrice" value="@Model.MaxPrice" /> }
                        @if (Model.SortBy != "newest") { <input type="hidden" name="sort" value="@Model.SortBy" /> }
                        @foreach (var group in Model.SpecFilters)
                        {
                            <fieldset class="spec-filter">
                                <legend class="spec-filter__name">
                                    @group.Name
                                    @if (!string.IsNullOrWhiteSpace(group.Hint)) { <span class="spec-filter__hint">@group.Hint</span> }
                                </legend>
                                @foreach (var option in group.Options)
                                {
                                    <label class="spec-filter__option" title="@option.Hint">
                                        <input type="checkbox" name="spec" value="@option.Id" checked="@option.Selected" />
                                        <span>@option.Value</span>
                                        <small>@option.ProductCount</small>
                                    </label>
                                }
                            </fieldset>
                        }
                        <noscript><div class="px-3 pb-3"><button type="submit" class="primary-btn">Áp dụng</button></div></noscript>
                    </form>
                </div>
            }

            <div class="sidebar-filter mt-50">
                <div class="top-filter-head">Bộ lọc sản phẩm</div>
                <div class="common-filter">
                    <div class="head">Từ khóa và khoảng giá</div>
                    <form asp-controller="Products" asp-action="Index" method="get" class="px-3 pb-3">
                        <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                        <input type="hidden" name="brandId" value="@Model.BrandId" />
                        <input type="hidden" name="sort" value="@Model.SortBy" />
                        @foreach (var specId in Model.SelectedSpecIds) { <input type="hidden" name="spec" value="@specId" /> }
                        <input type="hidden" id="minPrice" name="minPrice" value="@Model.MinPrice" />
                        <input type="hidden" id="maxPrice" name="maxPrice" value="@Model.MaxPrice" />
                        <label for="q">Tên sản phẩm</label>
                        <input id="q" name="q" value="@Model.Search" class="form-control mb-3" placeholder="Tìm sản phẩm" />
                        <div class="head px-0">Khoảng giá (₫)</div>
                        <div class="price-range-area">
                            <div id="price-range"
                                 data-range-min="0"
                                 data-range-max="@sliderMax.ToString(CultureInfo.InvariantCulture)"
                                 data-start-min="@sliderMinValue.ToString(CultureInfo.InvariantCulture)"
                                 data-start-max="@sliderMaxValue.ToString(CultureInfo.InvariantCulture)"
                                 data-step="1000"></div>
                            <div class="value-wrapper d-flex align-items-center mt-3">
                                <span class="price mr-1">Giá:</span>
                                <span id="lower-value" aria-live="polite"></span>
                                <span class="to mx-2">đến</span>
                                <span id="upper-value" aria-live="polite"></span>
                            </div>
                        </div>
                        <button type="submit" class="primary-btn mt-3">Áp dụng lọc</button>
                    </form>
                </div>
            </div>
        </aside>

        <main class="col-xl-9 col-lg-8 col-md-7">
            <form asp-controller="Products" asp-action="Index" method="get" class="filter-bar d-flex flex-wrap align-items-center">
                <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                        <input type="hidden" name="brandId" value="@Model.BrandId" />
                <input type="hidden" name="q" value="@Model.Search" />
                <input type="hidden" name="minPrice" value="@Model.MinPrice" />
                <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />
                @foreach (var specId in Model.SelectedSpecIds) { <input type="hidden" name="spec" value="@specId" /> }
                <div class="sorting mr-auto">Hiển thị @firstProductNumber–@lastProductNumber / @Model.TotalCount sản phẩm</div>
                <div class="sorting d-flex align-items-center">
                    <label for="sort" class="mr-2 mb-0">Sắp xếp:</label>
                    <select id="sort" name="sort" class="form-control">
                        <option value="newest" selected="@(Model.SortBy == "newest" ? "selected" : null)">Mới nhất</option>
                        <option value="price-asc" selected="@(Model.SortBy == "price-asc" ? "selected" : null)">Giá tăng dần</option>
                        <option value="price-desc" selected="@(Model.SortBy == "price-desc" ? "selected" : null)">Giá giảm dần</option>
                        <option value="name" selected="@(Model.SortBy == "name" ? "selected" : null)">Tên A–Z</option>
                    </select>
                </div>
                <button type="submit" class="primary-btn ml-3">Sắp xếp</button>
            </form>

            @if (hasActiveFilters)
            {
                <div class="active-filters" aria-label="Bộ lọc đang áp dụng">
                    <span class="active-filters__label">Đang lọc:</span>
                    @if (Model.Search is not null)
                    {
                        <a class="active-filter" href="@Link(query => query.Q = null)" title="Bỏ từ khóa">“@Model.Search” <span aria-hidden="true">×</span></a>
                    }
                    @if (categoryName is not null)
                    {
                        <a class="active-filter" href="@Link(query => { query.CategoryId = null; query.Spec.Clear(); })" title="Bỏ danh mục">@categoryName <span aria-hidden="true">×</span></a>
                    }
                    @if (brandName is not null)
                    {
                        <a class="active-filter" href="@Link(query => query.BrandId = null)" title="Bỏ thương hiệu">@brandName <span aria-hidden="true">×</span></a>
                    }
                    @foreach (var (groupName, option) in selectedOptions)
                    {
                        <a class="active-filter" href="@Link(query => query.Spec.Remove(option.Id))" title="Bỏ điều kiện này">@groupName: @option.Value <span aria-hidden="true">×</span></a>
                    }
                    @if (Model.MinPrice.HasValue || Model.MaxPrice.HasValue)
                    {
                        <a class="active-filter" href="@Link(query => { query.MinPrice = null; query.MaxPrice = null; })" title="Bỏ khoảng giá">
                            Giá @(Model.MinPrice.HasValue ? $"từ {Model.MinPrice:N0} ₫ " : "")@(Model.MaxPrice.HasValue ? $"đến {Model.MaxPrice:N0} ₫" : "") <span aria-hidden="true">×</span>
                        </a>
                    }
                    <a class="active-filters__clear" href="@basePath">Xóa tất cả</a>
                </div>
            }

            <section class="lattest-product-area pb-40 category-list">
                <div class="row">
                    @if (Model.Products.Count == 0)
                    {
                        <div class="col-12 text-center py-5">
                            <h4>Không tìm thấy sản phẩm phù hợp</h4>
                            <p>Hãy thử thay đổi danh mục hoặc khoảng giá.</p>
                            <a asp-controller="Products" asp-action="Index" class="primary-btn">Xem tất cả sản phẩm</a>
                        </div>
                    }
                    else
                    {
                        @foreach (var product in Model.Products)
                        {
                            <div class="col-lg-4 col-md-6">
                                <partial name="_ProductCard" model="product" />
                            </div>
                        }
                    }
                </div>
            </section>

            @if (Model.TotalPages > 1)
            {
                <div class="filter-bar d-flex flex-wrap align-items-center">
                    <div class="sorting mr-auto">Trang @Model.PageNumber / @Model.TotalPages</div>
                    <div class="pagination">
                        @if (Model.HasPreviousPage)
                        {
                            <a href="@Link(query => query.Page = Model.PageNumber - 1)" class="prev-arrow" aria-label="Trang trước">
                                <i class="fa fa-long-arrow-left" aria-hidden="true"></i>
                            </a>
                        }
                        @for (var pageNumberItem = startPage; pageNumberItem <= endPage; pageNumberItem++)
                        {
                            <a href="@Link(query => query.Page = pageNumberItem)" class="@(pageNumberItem == Model.PageNumber ? "active" : "")">
                                @pageNumberItem
                            </a>
                        }
                        @if (Model.HasNextPage)
                        {
                            <a href="@Link(query => query.Page = Model.PageNumber + 1)" class="next-arrow" aria-label="Trang sau">
                                <i class="fa fa-long-arrow-right" aria-hidden="true"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        </main>
    </div>
</div>
