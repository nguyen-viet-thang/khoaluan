@inject Microsoft.Extensions.Options.IOptions<PopPop.Models.StoreOptions> StoreOptionsAccessor
@inject Microsoft.Extensions.Options.IOptions<PopPop.Models.ShippingOptions> ShippingOptionsAccessor
@{
    var store = StoreOptionsAccessor.Value;
    var shipping = ShippingOptionsAccessor.Value;
    var hasContact = !string.IsNullOrWhiteSpace(store.Hotline)
        || !string.IsNullOrWhiteSpace(store.Address) || !string.IsNullOrWhiteSpace(store.OpeningHours);
}
<footer class="footer-area section_gap" id="contact">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 col-md-6 col-sm-6">
                <div class="single-footer-widget">
                    <h6>Về @store.Name</h6>
                    <p>@store.Name chuyên dụng cụ cầu lông chính hãng: vợt, giày, quần áo, quả cầu, cước và phụ kiện cho tập luyện và thi đấu.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="single-footer-widget">
                    <h6>Mua sắm</h6>
                    <ul class="store-footer__links">
                        <li><a asp-controller="Products" asp-action="Index">Tất cả sản phẩm</a></li>
                        <li><a asp-controller="Cart" asp-action="Index">Giỏ hàng</a></li>
                        <li><a asp-controller="Orders" asp-action="Index">Đơn hàng của tôi</a></li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="single-footer-widget">
                    <h6>Chính sách</h6>
                    <ul class="store-footer__links">
                        <li>Thanh toán khi nhận hàng (COD)</li>
                        <li>Phí giao hàng @(shipping.Fee == 0 ? "miễn phí" : $"{shipping.Fee:N0} ₫")@(shipping.Fee > 0 && shipping.FreeShippingThreshold > 0 ? $", miễn phí cho đơn từ {shipping.FreeShippingThreshold:N0} ₫" : string.Empty)</li>
                        <li>Hủy đơn trực tuyến khi đơn chưa được xác nhận</li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-2 col-md-6 col-sm-6">
                <div class="single-footer-widget">
                    <h6>Liên hệ</h6>
                    @if (hasContact)
                    {
                        <ul class="store-footer__links">
                            @if (!string.IsNullOrWhiteSpace(store.Hotline)) { <li><i class="fa fa-phone mr-1"></i>@store.Hotline</li> }
                                            @if (!string.IsNullOrWhiteSpace(store.Address)) { <li><i class="fa fa-map-marker mr-1"></i>@store.Address</li> }
                            @if (!string.IsNullOrWhiteSpace(store.OpeningHours)) { <li><i class="fa fa-clock-o mr-1"></i>@store.OpeningHours</li> }
                        </ul>
                    }
                    @if (!string.IsNullOrWhiteSpace(store.FacebookUrl))
                    {
                        <div class="footer-social d-flex align-items-center">
                            <a href="@store.FacebookUrl" target="_blank" rel="noopener" aria-label="Facebook"><i class="fa fa-facebook"></i></a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</footer>
