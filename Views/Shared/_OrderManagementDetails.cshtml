@model PopPop.Models.OrderManagementDetailsViewModel
@using PopPop.Data.Entities.Enums
@* Order details + status update form shared by the Admin and Staff areas. Caller sets ViewData["Area"]. *@
@{
    var area = ViewData["Area"] as string ?? "Staff";
    string StatusClass(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "status-pending",
        OrderStatus.Confirmed => "status-confirmed",
        OrderStatus.Processing => "status-processing",
        OrderStatus.Shipping => "status-shipping",
        OrderStatus.Completed => "status-completed",
        OrderStatus.Cancelled => "status-cancelled",
        _ => string.Empty
    };
    string ActionText(OrderStatus status) => status switch
    {
        OrderStatus.Confirmed => "Xác nhận đơn",
        OrderStatus.Processing => "Chuẩn bị hàng (đang xử lý)",
        OrderStatus.Shipping => "Giao cho đơn vị vận chuyển",
        OrderStatus.Completed => "Đã giao thành công (đã thu tiền COD)",
        OrderStatus.Cancelled => "Hủy đơn và hoàn kho",
        _ => status.ToString()
    };
}
<div class="admin-page-heading">
    <div><h2>Đơn hàng @Model.OrderCode</h2><p>Đặt lúc @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p></div>
    <a class="btn btn-outline-secondary" asp-area="@area" asp-controller="Orders" asp-action="Index"><i class="fa fa-arrow-left me-1"></i>Quay lại</a>
</div>
<div class="admin-order-grid mb-4">
    <section class="admin-detail-card">
        <h3>Thông tin đơn hàng</h3>
        <div class="admin-detail-row"><span>Trạng thái</span><span class="admin-status @StatusClass(Model.Status)">@Model.StatusText</span></div>
        <div class="admin-detail-row"><span>Thanh toán</span><strong>COD — @(Model.PaymentStatus == PaymentStatus.Paid ? "Đã thanh toán" : "Chưa thanh toán")</strong></div>
        @if (Model.PaidAt.HasValue)
        {
            <div class="admin-detail-row"><span>Thanh toán lúc</span><span>@Model.PaidAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div>
        }
        <div class="admin-detail-row"><span>Mã đơn</span><strong>@Model.OrderCode</strong></div>
        <div class="admin-detail-row"><span>Khách hàng</span><strong>@Model.CustomerName</strong></div>
        <div class="admin-detail-row"><span>SĐT tài khoản</span><span>@Model.CustomerAccountPhone</span></div>
    </section>
    <section class="admin-detail-card">
        <h3>Thông tin giao hàng</h3>
        <div class="admin-detail-row"><span>Người nhận</span><strong>@Model.RecipientName</strong></div>
        <div class="admin-detail-row"><span>Điện thoại</span><strong>@Model.RecipientPhone</strong></div>
        <div class="admin-detail-row"><span>Địa chỉ</span><strong>@Model.ShippingAddress</strong></div>
        <div class="admin-detail-row"><span>Ghi chú</span><span style="white-space:pre-line;text-align:right">@(string.IsNullOrWhiteSpace(Model.Note) ? "Không có" : Model.Note)</span></div>
    </section>
</div>
<div class="admin-panel mb-4">
    <div class="admin-panel-header"><h3>Sản phẩm trong đơn</h3></div>
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead><tr><th>Sản phẩm</th><th>Mã SKU</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr><td>@item.ProductName</td><td>@item.SKU</td><td>@item.UnitPrice.ToString("N0") ₫</td><td>@item.Quantity</td><td>@item.LineTotal.ToString("N0") ₫</td></tr>
                }
            </tbody>
            <tfoot>
                <tr><td colspan="4" class="text-end">Phí giao hàng</td><td>@(Model.ShippingFee == 0 ? "Miễn phí" : $"{Model.ShippingFee:N0} ₫")</td></tr>
                <tr><th colspan="4" class="text-end">Tổng cộng (thu khi giao)</th><th>@Model.TotalAmount.ToString("N0") ₫</th></tr>
            </tfoot>
        </table>
    </div>
</div>
@if (Model.AvailableStatuses.Count > 0)
{
    <section class="admin-detail-card">
        <h3>Cập nhật trạng thái</h3>
        <p class="admin-stat-note">Chuyển đơn theo đúng quy trình: xác nhận → chuẩn bị hàng → giao hàng → giao thành công. Có thể hủy đơn khi hàng chưa giao cho đơn vị vận chuyển; tồn kho sẽ được hoàn lại tự động.</p>
        <form asp-area="@area" asp-controller="Orders" asp-action="UpdateStatus" method="post" id="order-status-form">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="admin-actions mb-2">
                <select class="form-select" name="nextStatus" id="next-status" required style="max-width:320px">
                    <option value="">Chọn thao tác tiếp theo</option>
                    @foreach (var status in Model.AvailableStatuses)
                    {
                        <option value="@status">@ActionText(status)</option>
                    }
                </select>
                <button class="btn btn-primary" type="submit">Lưu trạng thái</button>
            </div>
            <div id="cancel-reason-group" hidden>
                <label for="cancel-reason" class="form-label">Lý do hủy</label>
                <input id="cancel-reason" name="cancelReason" class="form-control" maxlength="300" style="max-width:520px"
                       placeholder="VD: Khách yêu cầu hủy qua điện thoại, không liên lạc được khách..." />
            </div>
        </form>
    </section>
    <script>
        (function () {
            var select = document.getElementById('next-status');
            var group = document.getElementById('cancel-reason-group');
            var form = document.getElementById('order-status-form');
            select.addEventListener('change', function () { group.hidden = select.value !== 'Cancelled'; });
            form.addEventListener('submit', function (event) {
                if (select.value === 'Cancelled' && !confirm('Hủy đơn hàng @Model.OrderCode và hoàn lại tồn kho?')) {
                    event.preventDefault();
                }
            });
        })();
    </script>
}
