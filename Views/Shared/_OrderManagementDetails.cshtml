@model PopPop.Models.OrderManagementDetailsViewModel
@using PopPop.Data.Entities.Enums
@using PopPop.Services.Implementations
@* Order details + status actions shared by the Admin and Staff areas. Caller sets ViewData["Area"];
   the controller sets ViewData["ReturnUrl"] (the filtered list the user came from). *@
@{
    var area = ViewData["Area"] as string ?? "Staff";
    var returnUrl = ViewData["ReturnUrl"] as string;
    var backUrl = returnUrl ?? Url.Action("Index", "Orders", new { area });
    var forward = Model.AvailableStatuses.Where(status => status != OrderStatus.Cancelled).ToList();
    var canCancel = Model.AvailableStatuses.Contains(OrderStatus.Cancelled);
    string[] cancelReasons =
    [
        "Khách yêu cầu hủy qua điện thoại",
        "Không liên lạc được với khách",
        "Hết hàng / không đủ hàng",
        "Thông tin giao hàng không hợp lệ"
    ];
}
<div class="admin-page-heading">
    <div>
        <h2>Đơn hàng @Model.OrderCode <span class="admin-status @OrderDisplay.StatusClass(Model.Status)">@Model.StatusText</span></h2>
        <p>Đặt lúc @ShopClock.ToLocal(Model.CreatedAt).ToString("dd/MM/yyyy HH:mm") · @OrderDisplay.Ago(Model.CreatedAt)</p>
    </div>
    <a class="btn btn-outline-secondary" href="@backUrl"><i class="fa fa-arrow-left"></i>Quay lại danh sách</a>
</div>

@if (Model.AwaitingOnlinePayment)
{
    <div class="alert alert-warning d-flex align-items-center gap-2" role="status">
        <i class="fa fa-clock-o"></i>
        <div>Khách chưa thanh toán VNPAY. Hạn thanh toán: <strong>@ShopClock.ToLocal(Model.PaymentDeadline!.Value).ToString("HH:mm dd/MM")</strong>.
            Chỉ xử lý đơn sau khi khách thanh toán; quá hạn hệ thống tự hủy đơn và hoàn kho.</div>
    </div>
}

@if (Model.AvailableStatuses.Count > 0)
{
    <section class="admin-action-bar mb-4">
        <form asp-area="@area" asp-controller="Orders" asp-action="UpdateStatus" method="post" class="admin-action-bar__main">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <input type="hidden" name="fromDetails" value="true" />
            @foreach (var status in forward)
            {
                <button class="btn btn-primary btn-lg" type="submit" name="nextStatus" value="@status" disabled="@Model.AwaitingOnlinePayment">
                    <i class="fa @OrderDisplay.ActionIcon(status)"></i>@OrderDisplay.ActionText(status)
                </button>
            }
            <span class="admin-stat-note">Quy trình: xác nhận → chuẩn bị hàng → giao vận chuyển → giao thành công.</span>
        </form>
        @if (canCancel)
        {
            <button class="btn btn-outline-danger" type="button" data-toggle-target="#cancel-panel"><i class="fa fa-times"></i>Hủy đơn</button>
        }
    </section>

    @if (canCancel)
    {
        <section class="admin-detail-card admin-cancel-panel mb-4" id="cancel-panel" hidden>
            <h3>Hủy đơn @Model.OrderCode</h3>
            <form asp-area="@area" asp-controller="Orders" asp-action="UpdateStatus" method="post"
                  data-confirm="Hủy đơn hàng @Model.OrderCode và hoàn lại tồn kho?">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="nextStatus" value="@OrderStatus.Cancelled" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <input type="hidden" name="fromDetails" value="true" />
                <div class="admin-chips mb-2" role="group" aria-label="Lý do thường gặp">
                    @foreach (var reason in cancelReasons)
                    {
                        <button type="button" class="admin-chip" data-fill-target="#cancel-reason" data-fill-value="@reason">@reason</button>
                    }
                </div>
                <div class="admin-actions">
                    <input id="cancel-reason" name="cancelReason" class="form-control" maxlength="300" required style="max-width:520px"
                           placeholder="Lý do hủy (bắt buộc, khách sẽ nhận được thông báo)" />
                    <button class="btn btn-danger" type="submit">Xác nhận hủy &amp; hoàn kho</button>
                </div>
            </form>
        </section>
    }
}

<div class="admin-order-grid mb-4">
    <section class="admin-detail-card">
        <h3>Thông tin đơn hàng</h3>
        <div class="admin-detail-row"><span>Thanh toán</span><strong>@(Model.PaymentMethod == PaymentMethod.VnPay ? "VNPAY" : "COD") — @(Model.PaymentStatus == PaymentStatus.Paid ? "Đã thanh toán" : Model.AwaitingOnlinePayment ? "Chờ khách thanh toán" : "Chưa thanh toán")</strong></div>
        @if (Model.PaidAt.HasValue)
        {
            <div class="admin-detail-row"><span>Thanh toán lúc</span><span>@ShopClock.ToLocal(Model.PaidAt.Value).ToString("dd/MM/yyyy HH:mm")</span></div>
        }
        <div class="admin-detail-row"><span>Mã đơn</span><strong>@Model.OrderCode</strong></div>
        <div class="admin-detail-row"><span>Khách hàng</span><strong>@Model.CustomerName</strong></div>
        <div class="admin-detail-row"><span>SĐT tài khoản</span><span>@Model.CustomerAccountPhone</span></div>
    </section>
    <section class="admin-detail-card">
        <h3>Thông tin giao hàng</h3>
        <div class="admin-detail-row"><span>Người nhận</span><strong>@Model.RecipientName</strong></div>
        <div class="admin-detail-row">
            <span>Điện thoại</span>
            <span class="admin-actions">
                <a class="admin-link" href="tel:@Model.RecipientPhone">@Model.RecipientPhone</a>
                <button type="button" class="btn btn-sm btn-light" data-copy="@Model.RecipientPhone" title="Sao chép số điện thoại"><i class="fa fa-copy"></i></button>
            </span>
        </div>
        <div class="admin-detail-row">
            <span>Địa chỉ</span>
            <span class="admin-actions justify-content-end text-end">
                <strong>@Model.ShippingAddress</strong>
                <button type="button" class="btn btn-sm btn-light" data-copy="@Model.RecipientName - @Model.RecipientPhone - @Model.ShippingAddress" title="Sao chép thông tin giao hàng"><i class="fa fa-copy"></i></button>
            </span>
        </div>
        <div class="admin-detail-row"><span>Ghi chú</span><span style="white-space:pre-line;text-align:right">@(string.IsNullOrWhiteSpace(Model.Note) ? "Không có" : Model.Note)</span></div>
    </section>
</div>
<div class="admin-panel mb-4">
    <div class="admin-panel-header"><h3>Sản phẩm trong đơn</h3></div>
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead><tr><th>Sản phẩm</th><th>Mã SKU</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr><td>@item.ProductName</td><td>@item.SKU</td><td>@item.UnitPrice.ToString("N0") ₫</td><td>@item.Quantity</td><td>@item.LineTotal.ToString("N0") ₫</td></tr>
                }
            </tbody>
            <tfoot>
                <tr><td colspan="4" class="text-end">Phí giao hàng</td><td>@(Model.ShippingFee == 0 ? "Miễn phí" : $"{Model.ShippingFee:N0} ₫")</td></tr>
                <tr><th colspan="4" class="text-end">@(Model.PaymentMethod == PaymentMethod.CashOnDelivery && Model.PaymentStatus != PaymentStatus.Paid ? "Tổng cộng (thu khi giao)" : "Tổng cộng")</th><th>@Model.TotalAmount.ToString("N0") ₫</th></tr>
            </tfoot>
        </table>
    </div>
</div>
