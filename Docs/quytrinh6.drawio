<mxfile host="app.diagrams.net" type="device">
  <diagram id="q1" name="QT06. Quy trình lấy lại mật khẩu qua email">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="2730" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="q1-info" value="&lt;b&gt;UC06:&lt;/b&gt; Quy trình lấy lại mật khẩu qua email.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Chức năng đáp ứng:&lt;/b&gt; FR02, FR04 (CN04 – Đăng nhập; CN08 – Đổi mật khẩu).&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Tác nhân:&lt;/b&gt; Khách hàng, Nhân viên.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Mô tả:&lt;/b&gt; Cho phép người dùng quên mật khẩu tự đặt lại mật khẩu qua email của tài khoản. Hệ thống gửi liên kết đặt lại mật khẩu (dùng một lần, hiệu lực 24 giờ) tới email; người dùng mở liên kết, đặt mật khẩu mới và đăng nhập lại.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Tiền điều kiện:&lt;/b&gt; Người dùng đã có tài khoản đăng nhập bằng email (khách hàng) hoặc Gmail (nhân viên) và truy cập được hộp thư đó.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Hậu điều kiện:&lt;/b&gt; Mật khẩu của tài khoản được đặt lại theo mật khẩu mới người dùng chọn; người dùng có thể đăng nhập lại và tiếp tục sử dụng hệ thống." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;spacing=0;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1040" height="250" as="geometry" /></mxCell>
        <mxCell id="q1-title" value="SƠ ĐỒ HOẠT ĐỘNG: QUY TRÌNH LẤY LẠI MẬT KHẨU QUA EMAIL (QT06)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=14;fontStyle=1;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="270" width="1040" height="50" as="geometry" /></mxCell>
        <mxCell id="q1-lane0" value="Khách hàng, Nhân viên" style="swimlane;html=1;startSize=50;horizontal=1;fontSize=14;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="320" width="520" height="2410" as="geometry" /></mxCell>
