        <mxCell id="q1-n1" value="Tại trang đăng nhập, chọn &quot;Quên mật khẩu?&quot;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="60" y="505" width="400" height="80" as="geometry" /></mxCell>
