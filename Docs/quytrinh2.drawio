<mxfile host="app.diagrams.net" type="device">
  <diagram id="q1" name="QT02. Quy trình xử lý đơn hàng">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="1868" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="q1-info" value="&lt;b&gt;Chức năng đáp ứng:&lt;/b&gt; FR18, FR19 (CN24 – Xem danh sách đơn hàng; CN25 – Tìm kiếm, lọc đơn hàng; CN26 – Xem chi tiết đơn hàng (cửa hàng); CN27 – Cập nhật trạng thái đơn hàng; CN28 – Hủy đơn hàng (cửa hàng)).&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Tác nhân:&lt;/b&gt; Nhân viên.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Mô tả:&lt;/b&gt; Cho phép nhân viên tìm đơn hàng cần xử lý và chuyển đơn lần lượt qua các trạng thái Đã xác nhận, Đang xử lý, Đang giao, Đã giao thành công, hoặc hủy đơn khi hàng chưa giao cho đơn vị vận chuyển. Hệ thống kiểm tra thao tác hợp lệ, hoàn lại tồn kho khi hủy, ghi nhận đã thanh toán COD khi giao thành công và thông báo cho khách hàng.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Tiền điều kiện:&lt;/b&gt; Nhân viên đã đăng nhập trang quản lý; có đơn hàng chưa kết thúc (Chờ xác nhận, Đã xác nhận, Đang xử lý hoặc Đang giao).&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Hậu điều kiện:&lt;/b&gt; Đơn hàng được chuyển sang trạng thái mới (hủy đơn thì tồn kho được hoàn lại, giao thành công thì được ghi nhận đã thanh toán); khách hàng nhận thông báo về trạng thái đơn hàng." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;spacing=0;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1040" height="263" as="geometry" /></mxCell>
        <mxCell id="q1-title" value="SƠ ĐỒ HOẠT ĐỘNG: QUY TRÌNH XỬ LÝ ĐƠN HÀNG (QT02)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=14;fontStyle=1;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="283" width="1040" height="50" as="geometry" /></mxCell>
        <mxCell id="q1-lane0" value="Nhân viên" style="swimlane;html=1;startSize=50;horizontal=1;fontSize=14;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="333" width="520" height="1535" as="geometry" /></mxCell>
        <mxCell id="q1-lane1" value="Hệ thống" style="swimlane;html=1;startSize=50;horizontal=1;fontSize=14;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="520" y="333" width="520" height="1535" as="geometry" /></mxCell>
        <mxCell id="q1-start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="243" y="416" width="34" height="34" as="geometry" /></mxCell>
        <mxCell id="q1-n1" value="Xem danh sách đơn hàng; tìm kiếm, lọc theo trạng thái" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="60" y="518" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="q1-n2" value="Chọn đơn hàng cần xử lý" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="60" y="643" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="q1-n3" value="Hiển thị chi tiết đơn hàng và các thao tác được phép" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="580" y="768" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="q1-n4" value="Chọn thao tác tiếp theo (nhập lý do nếu hủy), chọn &quot;Lưu trạng thái&quot;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="60" y="893" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="q1-n5" value="Kiểm tra thao tác hợp lệ với trạng thái hiện tại" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="580" y="893" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="q1-d1" value="Thao tác hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;spacing=12;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="670" y="1008" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="q1-d2" value="Hủy đơn?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;spacing=12;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="670" y="1133" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="q1-n6" value="Hoàn lại tồn kho, ghi lịch sử nhập xuất kho, lưu lý do hủy" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="580" y="1268" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="q1-n7" value="Cập nhật trạng thái đơn; giao thành công thì ghi nhận đã thanh toán" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="580" y="1393" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="q1-n8" value="Gửi thông báo trạng thái đơn cho khách hàng" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="580" y="1518" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="q1-n9" value="Hiển thị danh sách đơn hàng, báo cập nhật thành công" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="580" y="1643" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="q1-n10" value="Xem đơn hàng ở trạng thái mới" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="60" y="1643" width="400" height="80" as="geometry" /></mxCell>
