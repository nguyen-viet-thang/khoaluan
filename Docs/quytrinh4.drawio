<mxfile host="app.diagrams.net" type="device">
  <diagram id="q1" name="QT04. Quy trình nhập kho">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="1709" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="q1-info" value="&lt;b&gt;UC04:&lt;/b&gt; Quy trình nhập kho.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Chức năng đáp ứng:&lt;/b&gt; FR23 (CN52 – Nhập kho; CN53 – Xem lịch sử nhập xuất kho).&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Tác nhân:&lt;/b&gt; Quản trị viên.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Mô tả:&lt;/b&gt; Cho phép quản trị viên nhập thêm hàng cho từng phiên bản sản phẩm bằng cách chọn phiên bản, nhập số lượng và ghi chú. Hệ thống cộng tồn kho và ghi lịch sử nhập xuất kho; hàng xuất kho do bán hàng, đổi bảo hành và hàng hoàn kho do hủy đơn được hệ thống tự ghi.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Tiền điều kiện:&lt;/b&gt; Quản trị viên đã đăng nhập trang quản trị; sản phẩm cần nhập đã có ít nhất một phiên bản.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Hậu điều kiện:&lt;/b&gt; Tồn kho của phiên bản được tăng thêm số lượng nhập; lịch sử nhập xuất kho ghi nhận giao dịch nhập hàng." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;spacing=0;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1040" height="229" as="geometry" /></mxCell>
        <mxCell id="q1-title" value="SƠ ĐỒ HOẠT ĐỘNG: QUY TRÌNH NHẬP KHO (QT04)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=14;fontStyle=1;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="249" width="1040" height="50" as="geometry" /></mxCell>
        <mxCell id="q1-lane0" value="Quản trị viên" style="swimlane;html=1;startSize=50;horizontal=1;fontSize=14;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="299" width="520" height="1410" as="geometry" /></mxCell>
        <mxCell id="q1-lane1" value="Hệ thống" style="swimlane;html=1;startSize=50;horizontal=1;fontSize=14;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="520" y="299" width="520" height="1410" as="geometry" /></mxCell>
        <mxCell id="q1-start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="243" y="382" width="34" height="34" as="geometry" /></mxCell>
        <mxCell id="q1-n1" value="Mở danh sách sản phẩm, tìm sản phẩm cần nhập hàng" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="60" y="484" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="q1-n2" value="Chọn sản phẩm cần nhập kho" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="60" y="609" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="q1-n3" value="Hiển thị chi tiết sản phẩm, các phiên bản kèm tồn kho và lịch sử kho" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="580" y="734" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="q1-n4" value="Chọn phiên bản, nhập số lượng và ghi chú" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="60" y="859" width="400" height="80" as="geometry" /></mxCell>
