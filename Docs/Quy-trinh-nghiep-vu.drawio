        <mxCell id="q1-n1" value="Chọn phiên bản và số lượng sản phẩm" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="60" y="497" width="400" height="80" as="geometry" /></mxCell>
