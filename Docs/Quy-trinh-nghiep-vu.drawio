<mxfile host="app.diagrams.net" type="device">
  <diagram id="q1" name="QT01. Quy trình đặt hàng">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="2347" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="q1-info" value="&lt;b&gt;Chức năng đáp ứng:&lt;/b&gt; FR11, FR12 (CN16 – Thêm sản phẩm vào giỏ hàng; CN17 – Xem giỏ hàng; CN18 – Cập nhật số lượng trong giỏ; CN19 – Xóa sản phẩm khỏi giỏ; CN20 – Đặt hàng).&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Tác nhân:&lt;/b&gt; Khách hàng.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Mô tả:&lt;/b&gt; Cho phép khách hàng chọn sản phẩm vào giỏ hàng, nhập thông tin giao hàng và đặt đơn hàng với hình thức thanh toán khi nhận hàng (COD). Hệ thống kiểm tra tồn kho, tạo đơn hàng ở trạng thái Chờ xác nhận và thông báo cho nhân viên cửa hàng.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Tiền điều kiện:&lt;/b&gt; Khách hàng đã đăng nhập; sản phẩm đang được bán (sản phẩm, danh mục và thương hiệu đều đang hoạt động) và còn hàng.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Hậu điều kiện:&lt;/b&gt; Đơn hàng mới được tạo ở trạng thái Chờ xác nhận, tồn kho được trừ và giỏ hàng được làm trống; nhân viên nhận thông báo để xử lý đơn hàng." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;spacing=0;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1040" height="242" as="geometry" /></mxCell>
        <mxCell id="q1-title" value="SƠ ĐỒ HOẠT ĐỘNG: QUY TRÌNH ĐẶT HÀNG (QT01)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=14;fontStyle=1;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="262" width="1040" height="50" as="geometry" /></mxCell>
        <mxCell id="q1-lane0" value="Khách hàng" style="swimlane;html=1;startSize=50;horizontal=1;fontSize=14;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="312" width="520" height="2035" as="geometry" /></mxCell>
