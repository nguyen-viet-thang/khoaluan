<mxfile host="build-kien-truc.ps1">
  <diagram id="kientruc" name="Kiến trúc hệ thống">
    <mxGraphModel dx="1400" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1005" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c11" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d4ed8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1420" height="280" as="geometry"/></mxCell>
        <mxCell id="c12" value="TẦNG GIAO DIỆN NGƯỜI DÙNG (CLIENT LAYER) — Trình duyệt web: Razor View (HTML) + Bootstrap/jQuery + SignalR client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f7fb;strokeColor=#1d4ed8;strokeWidth=2;align=left;spacingLeft=10;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1420" height="40" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;div style=&apos;font-size:16px;font-weight:bold;color:#1d4ed8;margin-bottom:6px&apos;&gt;Cửa hàng trực tuyến&lt;/div&gt;&lt;div style=&apos;border-top:1px dashed #c8cdd6;padding-top:6px;line-height:1.35&apos;&gt;&amp;bull; &lt;b&gt;Xem, tìm, lọc sản phẩm:&lt;/b&gt; theo danh mục, thương hiệu, khoảng giá và thông số kỹ thuật&lt;br&gt;&amp;bull; &lt;b&gt;Giỏ hàng &amp;amp; đặt hàng COD:&lt;/b&gt; theo dõi trạng thái đơn, tự hủy khi đơn còn chờ xác nhận&lt;br&gt;&amp;bull; &lt;b&gt;Bảo hành / đổi hàng lỗi:&lt;/b&gt; gửi yêu cầu kèm video minh chứng, theo dõi tiến độ&lt;br&gt;&amp;bull; &lt;b&gt;Tài khoản:&lt;/b&gt; đăng ký và xác nhận qua email, quên mật khẩu, xem thông báo&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d4ed8;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Arial;fontSize=14;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="448" height="205" as="geometry"/></mxCell>
        <mxCell id="c14" value="Khách vãng lai / Khách hàng" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#1d4ed8;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="240" y="85" width="236" height="24" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;div style=&apos;font-size:16px;font-weight:bold;color:#1d4ed8;margin-bottom:6px&apos;&gt;Khu vực nhân viên (/Staff)&lt;/div&gt;&lt;div style=&apos;border-top:1px dashed #c8cdd6;padding-top:6px;line-height:1.35&apos;&gt;&amp;bull; &lt;b&gt;Xử lý đơn hàng:&lt;/b&gt; xác nhận → đang xử lý → đang giao → đã giao, hoặc hủy (hoàn kho)&lt;br&gt;&amp;bull; &lt;b&gt;Xử lý yêu cầu bảo hành:&lt;/b&gt; duyệt, yêu cầu bổ sung, từ chối, ghi nhận gửi trả hàng, nhắn khách&lt;br&gt;&amp;bull; &lt;b&gt;Chuông thông báo thời gian thực:&lt;/b&gt; đơn mới, yêu cầu bảo hành mới, khách hủy đơn&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d4ed8;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Arial;fontSize=14;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="506" y="75" width="448" height="205" as="geometry"/></mxCell>
        <mxCell id="c16" value="Nhân viên" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#1d4ed8;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="850" y="85" width="92" height="24" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;div style=&apos;font-size:16px;font-weight:bold;color:#1d4ed8;margin-bottom:6px&apos;&gt;Khu vực quản trị (/Admin)&lt;/div&gt;&lt;div style=&apos;border-top:1px dashed #c8cdd6;padding-top:6px;line-height:1.35&apos;&gt;&amp;bull; &lt;b&gt;Danh mục hàng hóa:&lt;/b&gt; danh mục, thương hiệu, sản phẩm, phiên bản, ảnh, thông số, tồn kho&lt;br&gt;&amp;bull; &lt;b&gt;Tài khoản:&lt;/b&gt; khóa/mở khách hàng, cấp mật khẩu tạm; tạo và quản lý nhân viên&lt;br&gt;&amp;bull; &lt;b&gt;Chính sách bảo hành:&lt;/b&gt; số ngày theo thương hiệu × danh mục&lt;br&gt;&amp;bull; &lt;b&gt;Thống kê:&lt;/b&gt; bảng điều khiển, báo cáo doanh thu, xuất Excel&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d4ed8;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Arial;fontSize=14;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="972" y="75" width="448" height="205" as="geometry"/></mxCell>
        <mxCell id="c18" value="Quản trị viên" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#1d4ed8;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="1284" y="85" width="124" height="24" as="geometry"/></mxCell>
        <mxCell id="c19" style="endArrow=block;startArrow=block;endFill=1;startFill=1;html=1;strokeWidth=2;strokeColor=#1d4ed8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="300" as="sourcePoint"/><mxPoint x="730" y="375" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c20" value="HTTPS: yêu cầu GET/POST (form HTML) + cookie đăng nhập + mã chống giả mạo • WebSocket SignalR /hubs/notifications (máy chủ chủ động đẩy thông báo)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="745" y="304" width="690" height="67" as="geometry"/></mxCell>
        <mxCell id="c21" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b21b6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="375" width="1420" height="280" as="geometry"/></mxCell>
        <mxCell id="c22" value="TẦNG ỨNG DỤNG &amp;amp; NGHIỆP VỤ (APPLICATION LAYER) — ASP.NET Core 10 MVC, kiến trúc N-tier: Controller → Service → Repository" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f7fb;strokeColor=#5b21b6;strokeWidth=2;align=left;spacingLeft=10;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#5b21b6;" vertex="1" parent="1"><mxGeometry x="20" y="375" width="1420" height="40" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;div style=&apos;font-size:16px;font-weight:bold;color:#5b21b6;margin-bottom:6px&apos;&gt;Tiếp nhận &amp;amp; Phân quyền&lt;/div&gt;&lt;div style=&apos;border-top:1px dashed #c8cdd6;padding-top:6px;line-height:1.35&apos;&gt;&amp;bull; &lt;b&gt;Pipeline (Program.cs):&lt;/b&gt; HTTPS → định tuyến → tệp tĩnh → xác thực → bắt đổi mật khẩu → phân quyền&lt;br&gt;&amp;bull; &lt;b&gt;Bộ điều khiển:&lt;/b&gt; Controllers/, Areas/Admin, Areas/Staff, Areas/Identity (Razor Pages)&lt;br&gt;&amp;bull; &lt;b&gt;Phân quyền theo vai trò:&lt;/b&gt; [Authorize(Roles = &quot;Admin&quot;)], &quot;Admin,Staff&quot;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b21b6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Arial;fontSize=14;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="331" height="205" as="geometry"/></mxCell>
        <mxCell id="c24" value="Controllers" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b21b6;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#5b21b6;" vertex="1" parent="1"><mxGeometry x="251" y="440" width="108" height="24" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;div style=&apos;font-size:16px;font-weight:bold;color:#5b21b6;margin-bottom:6px&apos;&gt;Xử lý nghiệp vụ&lt;/div&gt;&lt;div style=&apos;border-top:1px dashed #c8cdd6;padding-top:6px;line-height:1.35&apos;&gt;&amp;bull; &lt;b&gt;Dịch vụ:&lt;/b&gt; OrderService, CartService, ProductService, WarrantyClaimService, ReportService…&lt;br&gt;&amp;bull; &lt;b&gt;Quy tắc:&lt;/b&gt; tồn kho, phí vận chuyển, vòng đời đơn hàng, hạn bảo hành&lt;br&gt;&amp;bull; &lt;b&gt;Chuyển đổi:&lt;/b&gt; Entity ↔ ViewModel (thư mục Models/)&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b21b6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Arial;fontSize=14;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="389" y="430" width="331" height="205" as="geometry"/></mxCell>
        <mxCell id="c26" value="Services" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b21b6;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#5b21b6;" vertex="1" parent="1"><mxGeometry x="618" y="440" width="90" height="24" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;div style=&apos;font-size:16px;font-weight:bold;color:#5b21b6;margin-bottom:6px&apos;&gt;Truy cập dữ liệu&lt;/div&gt;&lt;div style=&apos;border-top:1px dashed #c8cdd6;padding-top:6px;line-height:1.35&apos;&gt;&amp;bull; &lt;b&gt;Repository dùng chung:&lt;/b&gt; Repository&amp;lt;T&amp;gt; + repository riêng từng nghiệp vụ&lt;br&gt;&amp;bull; &lt;b&gt;Lọc sản phẩm:&lt;/b&gt; CatalogFiltering (thông số, từ khóa, giá)&lt;br&gt;&amp;bull; &lt;b&gt;UnitOfWork:&lt;/b&gt; gom thao tác vào một giao dịch Serializable, lỗi thì rollback&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b21b6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Arial;fontSize=14;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="738" y="430" width="331" height="205" as="geometry"/></mxCell>
        <mxCell id="c28" value="Repositories" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b21b6;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#5b21b6;" vertex="1" parent="1"><mxGeometry x="941" y="440" width="116" height="24" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;div style=&apos;font-size:16px;font-weight:bold;color:#5b21b6;margin-bottom:6px&apos;&gt;Thông báo thời gian thực&lt;/div&gt;&lt;div style=&apos;border-top:1px dashed #c8cdd6;padding-top:6px;line-height:1.35&apos;&gt;&amp;bull; &lt;b&gt;NotificationService:&lt;/b&gt; lưu bảng Notifications rồi đẩy qua NotificationHub&lt;br&gt;&amp;bull; &lt;b&gt;Đúng người nhận:&lt;/b&gt; Clients.User(mã người dùng)&lt;br&gt;&amp;bull; &lt;b&gt;An toàn giao dịch:&lt;/b&gt; chỉ gửi sau khi đã commit; lỗi gửi thông báo không làm hỏng nghiệp vụ&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b21b6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Arial;fontSize=14;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1087" y="430" width="331" height="205" as="geometry"/></mxCell>
        <mxCell id="c30" value="SignalR" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b21b6;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#5b21b6;" vertex="1" parent="1"><mxGeometry x="1316" y="440" width="90" height="24" as="geometry"/></mxCell>
        <mxCell id="c31" style="endArrow=block;startArrow=block;endFill=1;startFill=1;html=1;strokeWidth=2;strokeColor=#0f766e;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="655" as="sourcePoint"/><mxPoint x="730" y="730" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c32" value="EF Core 10 (LINQ → T-SQL qua PopPopDbContext) • Đọc/ghi tệp trên ổ đĩa máy chủ • Gửi email SMTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#0f766e;" vertex="1" parent="1"><mxGeometry x="745" y="659" width="690" height="67" as="geometry"/></mxCell>
        <mxCell id="c33" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="730" width="1420" height="255" as="geometry"/></mxCell>
        <mxCell id="c34" value="TẦNG LƯU TRỮ &amp;amp; DỊCH VỤ NGOẠI VI (DATA &amp;amp; EXTERNAL SERVICES)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f7fb;strokeColor=#0f766e;strokeWidth=2;align=left;spacingLeft=10;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#0f766e;" vertex="1" parent="1"><mxGeometry x="20" y="730" width="1420" height="40" as="geometry"/></mxCell>
        <mxCell id="c35" value="&lt;div style=&apos;font-size:16px;font-weight:bold;color:#15803d;margin-bottom:6px&apos;&gt;Hệ quản trị CSDL SQL Server&lt;/div&gt;&lt;div style=&apos;border-top:1px dashed #c8cdd6;padding-top:6px;line-height:1.35&apos;&gt;&amp;bull; &lt;b&gt;CSDL PopPopShop:&lt;/b&gt; 22 thực thể (gồm bảng tài khoản, vai trò của ASP.NET Core Identity)&lt;br&gt;&amp;bull; &lt;b&gt;Lược đồ:&lt;/b&gt; EF Core Migrations (Data/Migrations), dữ liệu mẫu Data/Seed&lt;br&gt;&amp;bull; &lt;b&gt;Toàn vẹn:&lt;/b&gt; khóa ngoại, chỉ mục duy nhất (SKU, mã đơn PP-…, mã yêu cầu BH-…)&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#15803d;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Arial;fontSize=14;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="785" width="448" height="180" as="geometry"/></mxCell>
        <mxCell id="c36" value="RDBMS" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#15803d;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#15803d;" vertex="1" parent="1"><mxGeometry x="386" y="795" width="90" height="24" as="geometry"/></mxCell>
        <mxCell id="c37" value="&lt;div style=&apos;font-size:16px;font-weight:bold;color:#b91c1c;margin-bottom:6px&apos;&gt;Lưu trữ tệp trên máy chủ&lt;/div&gt;&lt;div style=&apos;border-top:1px dashed #c8cdd6;padding-top:6px;line-height:1.35&apos;&gt;&amp;bull; &lt;b&gt;Ảnh sản phẩm:&lt;/b&gt; wwwroot/uploads/products (công khai)&lt;br&gt;&amp;bull; &lt;b&gt;Minh chứng bảo hành:&lt;/b&gt; App_Data/claims/{mã yêu cầu} — ngoài wwwroot, chỉ tải qua action có kiểm tra quyền&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b91c1c;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Arial;fontSize=14;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="506" y="785" width="448" height="180" as="geometry"/></mxCell>
        <mxCell id="c38" value="File system" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#b91c1c;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#b91c1c;" vertex="1" parent="1"><mxGeometry x="834" y="795" width="108" height="24" as="geometry"/></mxCell>
        <mxCell id="c39" value="&lt;div style=&apos;font-size:16px;font-weight:bold;color:#c2410c;margin-bottom:6px&apos;&gt;Dịch vụ bên ngoài&lt;/div&gt;&lt;div style=&apos;border-top:1px dashed #c8cdd6;padding-top:6px;line-height:1.35&apos;&gt;&amp;bull; &lt;b&gt;Máy chủ SMTP:&lt;/b&gt; email xác nhận tài khoản, email đặt lại mật khẩu (SmtpEmailSender)&lt;br&gt;&amp;bull; &lt;b&gt;CDN jsDelivr / cdnjs:&lt;/b&gt; thư viện SignalR client, Popper.js&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2410c;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Arial;fontSize=14;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="972" y="785" width="448" height="180" as="geometry"/></mxCell>
        <mxCell id="c40" value="External" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#c2410c;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#c2410c;" vertex="1" parent="1"><mxGeometry x="1318" y="795" width="90" height="24" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>