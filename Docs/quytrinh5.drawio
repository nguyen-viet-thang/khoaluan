<mxfile host="app.diagrams.net" type="device">
  <diagram id="q1" name="QT05. Quy trình đăng ký và xác nhận email">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="2084" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="q1-info" value="&lt;b&gt;UC05:&lt;/b&gt; Quy trình đăng ký và xác nhận email.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Chức năng đáp ứng:&lt;/b&gt; FR01 (CN01 – Đăng ký tài khoản; CN02 – Xác nhận email; CN03 – Gửi lại email xác nhận).&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Tác nhân:&lt;/b&gt; Khách vãng lai.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Mô tả:&lt;/b&gt; Cho phép khách vãng lai đăng ký tài khoản bằng họ tên, email và mật khẩu. Hệ thống tạo tài khoản ở trạng thái chưa xác thực và gửi liên kết xác thực về email; khách mở liên kết để kích hoạt tài khoản, có thể yêu cầu gửi lại liên kết khi liên kết hết hạn hoặc không nhận được email.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Tiền điều kiện:&lt;/b&gt; Khách chưa đăng nhập; email dùng để đăng ký chưa có tài khoản trong hệ thống.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Hậu điều kiện:&lt;/b&gt; Tài khoản khách hàng mới được tạo lập và xác thực email; người dùng có thể đăng nhập và bắt đầu sử dụng hệ thống." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;spacing=0;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1040" height="229" as="geometry" /></mxCell>
        <mxCell id="q1-title" value="SƠ ĐỒ HOẠT ĐỘNG: QUY TRÌNH ĐĂNG KÝ VÀ XÁC NHẬN EMAIL (QT05)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=14;fontStyle=1;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="249" width="1040" height="50" as="geometry" /></mxCell>
        <mxCell id="q1-lane0" value="Khách vãng lai" style="swimlane;html=1;startSize=50;horizontal=1;fontSize=14;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="299" width="520" height="1785" as="geometry" /></mxCell>
        <mxCell id="q1-lane1" value="Hệ thống" style="swimlane;html=1;startSize=50;horizontal=1;fontSize=14;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="520" y="299" width="520" height="1785" as="geometry" /></mxCell>
