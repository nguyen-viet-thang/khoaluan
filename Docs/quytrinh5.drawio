        <mxCell id="q1-n1" value="Mở trang đăng ký, nhập họ tên, email, mật khẩu và xác nhận mật khẩu" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="60" y="484" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="q1-n2" value="Chọn &quot;Đăng ký&quot;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="60" y="609" width="400" height="80" as="geometry" /></mxCell>
