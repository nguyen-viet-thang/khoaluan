        <mxCell id="q1-n1" value="Chọn đơn hàng đã giao và sản phẩm cần bảo hành hoặc đổi" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="60" y="497" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="q1-n2" value="Chọn loại lỗi, nhập mô tả, tải video minh chứng" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="60" y="622" width="400" height="80" as="geometry" /></mxCell>
