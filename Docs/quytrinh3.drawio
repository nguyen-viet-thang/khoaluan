<mxfile host="app.diagrams.net" type="device">
  <diagram id="q1" name="QT03. Quy trình bảo hành và đổi hàng lỗi">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="2972" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="q1-info" value="&lt;b&gt;Chức năng đáp ứng:&lt;/b&gt; FR15, FR16, FR20 (CN29 – Tạo yêu cầu bảo hành / đổi hàng lỗi; CN30 – Xem danh sách và chi tiết yêu cầu bảo hành; CN31 – Bổ sung bằng chứng; CN32 – Khai báo thông tin gửi hàng; CN33 – Hủy yêu cầu bảo hành; CN34 – Xác nhận đã nhận sản phẩm; CN35 – Xem danh sách yêu cầu bảo hành; CN36 – Xem chi tiết yêu cầu và bằng chứng; CN37 – Xử lý yêu cầu bảo hành).&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Tác nhân:&lt;/b&gt; Khách hàng, Nhân viên.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Mô tả:&lt;/b&gt; Cho phép khách hàng gửi yêu cầu đổi hàng lỗi khi nhận hoặc bảo hành cho sản phẩm đã mua kèm video minh chứng; nhân viên xem xét, yêu cầu bổ sung, duyệt hoặc từ chối, nhận sản phẩm khách gửi về, gửi hãng thẩm định khi cần và gửi sản phẩm thay thế cho khách. Cửa hàng không hoàn tiền: mỗi yêu cầu kết thúc bằng một sản phẩm thay thế hoặc bị từ chối.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Tiền điều kiện:&lt;/b&gt; Khách hàng đã đăng nhập; đơn hàng ở trạng thái Đã giao thành công; sản phẩm còn trong thời hạn đổi hàng lỗi hoặc thời hạn bảo hành và chưa có yêu cầu khác đang xử lý.&lt;div style=&quot;height:8px&quot;&gt;&lt;/div&gt;&lt;b&gt;Hậu điều kiện:&lt;/b&gt; Khách hàng nhận được sản phẩm thay thế và yêu cầu ở trạng thái Hoàn tất (hoặc yêu cầu bị từ chối kèm lý do); lịch sử xử lý và tồn kho được cập nhật." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;spacing=0;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1560" height="242" as="geometry" /></mxCell>
        <mxCell id="q1-title" value="SƠ ĐỒ HOẠT ĐỘNG: QUY TRÌNH BẢO HÀNH VÀ ĐỔI HÀNG LỖI (QT03)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=14;fontStyle=1;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="262" width="1560" height="50" as="geometry" /></mxCell>
        <mxCell id="q1-lane0" value="Khách hàng" style="swimlane;html=1;startSize=50;horizontal=1;fontSize=14;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="312" width="520" height="2660" as="geometry" /></mxCell>
        <mxCell id="q1-lane1" value="Nhân viên" style="swimlane;html=1;startSize=50;horizontal=1;fontSize=14;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="520" y="312" width="520" height="2660" as="geometry" /></mxCell>
