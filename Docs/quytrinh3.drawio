        <mxCell id="q1-n9" value="Duyệt yêu cầu, hướng dẫn khách gửi sản phẩm về" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="580" y="1622" width="400" height="80" as="geometry" /></mxCell>
