        <mxCell id="q1-d3" value="Chấp nhận yêu cầu?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;spacing=12;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="670" y="1487" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="q1-n8" value="Chuyển Từ chối, lưu lý do, thông báo cho khách hàng" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1100" y="1497" width="400" height="80" as="geometry" /></mxCell>
